    },
    {
     "type": "object",
     "properties": {
      "do": {
       "const": "wait"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
      "client": {
       "$ref": "#/$defs/alias"
      },
      "note": {
       "type": "string",
       "maxLength": 300
      },
      "signal": {
       "$ref": "#/$defs/signal"
      },
      "timeout_ms": {
       "type": "integer",
       "minimum": 500,
       "maximum": 300000
      },
      "armed_at": {
       "$ref": "#/$defs/id"
      },
      "bind": {
       "type": "object",
       "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,23}$"
       },
       "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,23}$"
       },
       "description": "var -> named regex group: later text may use ${var}."
      },
      "retry": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "step",
        "every_ms",
        "times"
       ],
       "description": "Client signals only: when the signal has not come within every_ms, send that earlier step again, up to times (the lost world click). timeout_ms still bounds the whole wait.",
       "properties": {
        "step": {
         "$ref": "#/$defs/id"
        },
        "every_ms": {
         "type": "integer",
         "minimum": 1000,
         "maximum": 30000
        },
        "times": {
         "type": "integer",
         "minimum": 1,
         "maximum": 5
        }
       }
      }
     },
     "required": [
      "do",
      "id",
      "signal",
      "timeout_ms"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
