        "SHIFT",
        "CTRL+F10",
        "CTRL+F11"
       ]
      },
      "hold_ms": {
       "type": "integer",
       "minimum": 0,
       "maximum": 10000
      }
     },
     "required": [
      "do",
      "key"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "do": {
       "const": "move"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
      "client": {
       "$ref": "#/$defs/alias"
      },
      "note": {
       "type": "string",
       "maxLength": 300
      },
      "dir": {
       "enum": [
        "left",
        "right",
        "up",
        "down"
       ]
      },
      "ms": {
       "type": "integer",
       "minimum": 50,
       "maximum": 10000
      }
     },
     "required": [
      "do",
      "dir",
      "ms"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "do": {
       "const": "jump"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
      "client": {
       "$ref": "#/$defs/alias"
      },
      "note": {
