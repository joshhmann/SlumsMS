      "do": {
       "const": "chat"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
      "client": {
       "$ref": "#/$defs/alias"
      },
      "note": {
       "type": "string",
       "maxLength": 300
      },
      "text": {
       "type": "string",
       "minLength": 1,
       "maxLength": 120
      }
     },
     "required": [
      "do",
      "text"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "do": {
       "const": "gm"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
      "client": {
       "$ref": "#/$defs/alias"
      },
      "note": {
       "type": "string",
       "maxLength": 300
      },
      "line": {
       "type": "string",
       "pattern": "^![a-z]",
       "maxLength": 120
      }
     },
     "required": [
      "do",
      "line"
     ],
     "additionalProperties": false
    },
    {
