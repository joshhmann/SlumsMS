{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://slumsms.local/qa/client-scripts/schema.json",
 "title": "SlumsMS auto-QA client script (qa-scripts/<id>.yaml)",
 "description": "One check played by the auto-QA runner (the client-mcp worker's run_script on Silvia) against TEST. Spec: docs/qa/client-scripts/README.md. Validate with tools/qa-scripts/validate.",
 "type": "object",
 "required": [
  "id",
  "title",
  "covers",
  "server",
  "clients",
  "steps",
  "expect"
 ],
 "additionalProperties": false,
 "properties": {
  "id": {
   "$ref": "#/$defs/id"
  },
  "title": {
   "type": "string",
   "minLength": 5,
   "maxLength": 120
  },
  "covers": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^(b[0-9]{1,4}|t-[a-z]{2}-[0-9]{1,2}|q[w]?[0-9]{2}|ticket-[0-9]{1,4}|feature-[a-z0-9-]+)$"
   },
   "description": "What this script settles: bug ids (b140), auto-QA check ids (t-cl-1), release-book Test rows (q48), tickets, features."
  },
  "status": {
   "enum": [
    "draft",
    "ready",
    "retired"
   ],
   "description": "draft: written, not yet passed on TEST. ready: passed on TEST at least once."
  },
  "server": {
   "const": "test",
   "description": "Always TEST (192.168.0.164:8489). The QA client build is refused by live."
  },
  "needs": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "enum": [
     "gm",
     "two_clients",
     "owned_alt",
     "new_character",
     "kpq_free_channel",
     "cash_shop",
     "female_character",
     "pet",
     "mechanics",
     "proposed_anchors",
     "proposed_windows",
     "proposed_signals",
     "proposed_steps"
    ]
   },
   "description": "Staging the runner/vault must provide before the run (e.g. owned_alt: the account has an offline second character)."
  },
  "notes": {
   "type": "string",
   "maxLength": 2000
  },
  "clients": {
   "type": "object",
   "minProperties": 1,
   "maxProperties": 2,
   "propertyNames": {
    "$ref": "#/$defs/alias"
   },
   "additionalProperties": {
    "$ref": "#/$defs/client"
   }
  },
  "steps": {
   "type": "array",
   "minItems": 1,
   "maxItems": 200,
   "items": {
    "$ref": "#/$defs/step"
   }
  },
  "captures": {
   "type": "array",
   "maxItems": 40,
   "items": {
    "$ref": "#/$defs/capture"
   }
  },
  "expect": {
   "$ref": "#/$defs/expect"
  }
 },
 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
  },
  "alias": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]{0,15}$"
  },
  "span": {
   "type": "object",
   "properties": {
    "from": {
     "$ref": "#/$defs/id"
    },
    "to": {
     "$ref": "#/$defs/id"
    }
   },
   "additionalProperties": false
  },
  "client": {
   "type": "object",
   "required": [
    "account",
    "world",
    "channel"
   ],
   "additionalProperties": false,
   "properties": {
    "account": {
     "type": "object",
     "required": [
      "vault"
     ],
     "additionalProperties": false,
     "properties": {
      "vault": {
       "type": "string",
       "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
       "description": "An alias in the runner's QA vault on Silvia. Never a name or password."
      }
     }
    },
    "character": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "slot": {
       "type": "integer",
       "minimum": 0,
       "maximum": 14
      },
      "vault": {
       "type": "string",
       "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
      }
     },
     "description": "Which character to pick: a slot, or a vault alias whose entry names the slot. Default slot 0."
    },
    "world": {
     "const": "Bera"
    },
    "channel": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    },
    "gm": {
     "type": "boolean"
    }
   }
  },
  "signal": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "name"
     ],
     "description": "A client pipe signal from the QA module, relayed by the Silvia worker. Built (client-170-qa-module): worldselect.ready (world list handled and drawn), channels.ready (SERVERSTATUS 0x03, the reply to clicking a world: a lost world click shows as its absence), charselect.ready, field.ready (map_id narrows it). Proposed: chat.received (regex), window.open / window.closed (window).",
     "properties": {
      "type": {
       "const": "client_signal"
      },
      "name": {
       "enum": [
        "worldselect.ready",
        "channels.ready",
        "charselect.ready",
        "field.ready",
        "chat.received",
        "window.open",
        "window.closed"
       ]
      },
      "map_id": {
       "type": "integer",
       "minimum": 0,
       "maximum": 999999999
      },
      "regex": {
       "type": "string",
       "minLength": 1,
       "maxLength": 300
      },
      "window": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]*$"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "topic",
      "regex",
      "char"
     ],
     "description": "A QA event feed line (GET /qa/events on TEST, long-polled by the 187 orchestrator over ssh) of this topic, about this client's character (or any), matching regex.",
     "properties": {
      "type": {
       "const": "server_line"
      },
      "topic": {
       "enum": [
        "OWNED_ALT",
        "ATTACK",
        "GUILD",
        "FM_BUY",
        "ROPE",
        "HIDE",
        "MOB_CONTROL",
        "BOT_CHAT",
        "MERCHANT",
        "STORAGE",
        "EQUIP",
        "SCROLL",
        "CHANNEL_LOAD",
        "IDLE",
        "SLIDE",
        "MAP_ENTRY",
        "BOUNCE",
        "GACHA",
        "WEALTH",
        "AFFINITY",
        "COUPLE",
        "BOT_GUILD",
        "COMBAT",
        "HABITS",
        "MANNERS",
        "SPREAD",
        "TRADE",
        "PETS",
        "RING",
        "ROMANCE",
        "RIVALRY",
        "GUILD_WAR",
        "CONVO",
        "NPC",
        "AUTOQA",
        "PQ",
        "LIKENESS",
        "SOCIAL_GATE",
        "MEMORY",
        "WORLD_EVENT",
        "MAP_CHANGE",
        "CHAT",
        "MECHANICS",
        "STAGING",
        "QA_RUN"
       ]
      },
      "regex": {
       "type": "string",
       "minLength": 1,
       "maxLength": 300
      },
      "char": {
       "type": "string",
       "pattern": "^([a-z][a-z0-9_]{0,15}|any)$"
      }
     }
    }
   ]
  },
  "step": {
   "oneOf": [
    {
     "type": "object",
     "properties": {
      "do": {
       "const": "login"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
      "client": {
       "$ref": "#/$defs/alias"
      },
      "note": {
       "type": "string",
       "maxLength": 300
      }
     },
     "required": [
      "do"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "do": {
       "const": "select_world"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
      "client": {
       "$ref": "#/$defs/alias"
      },
      "note": {
       "type": "string",
       "maxLength": 300
      },
      "world": {
       "const": "Bera"
      }
     },
     "required": [
      "do",
      "world"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "do": {
       "const": "select_channel"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
      "client": {
       "$ref": "#/$defs/alias"
      },
      "note": {
       "type": "string",
       "maxLength": 300
      },
      "channel": {
       "type": "integer",
       "minimum": 1,
       "maximum": 5
      }
     },
     "required": [
      "do",
      "channel"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
     "properties": {
      "do": {
       "const": "select_character"
      },
      "id": {
       "$ref": "#/$defs/id"
      },
      "client": {
       "$ref": "#/$defs/alias"
      },
      "note": {
       "type": "string",
       "maxLength": 300
      }
     },
     "required": [
      "do"
     ],
     "additionalProperties": false
    },
    {
     "type": "object",
