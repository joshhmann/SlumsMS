        text = pick_cody(t, "maintenance_start", {"name": name, "minutes": minutes}, args.dry_run)
        if args.reason:
            text += " " + pick_cody(t, "maintenance_reason", {"reason": args.reason}, args.dry_run)
        result = post_announce(t, text, dry_run=args.dry_run, priority=True)
        if not args.dry_run:
            s = load_json(maintenance_state_path(t), {})
            s["announced"] = result == "sent"
            save_json(maintenance_state_path(t), s)
            print("maintenance on; announce %s" % result)
        return 1 if result == "failed" else 0

    # end
    if args.dry_run:
        print("[dry-run] would remove %s" % (path or "(no MAINTENANCE_FILE)"))
    else:
        if path and os.path.exists(path):
            os.remove(path)
        if os.path.exists(maintenance_state_path(t)):
            os.remove(maintenance_state_path(t))
        t.log("[maintenance] end")
    if not active:
        print("was not in maintenance; nothing announced")
        return 0
    if args.no_announce:
        print("maintenance off (not announced)")
        return 0
    text = pick_cody(t, "maintenance_end", {"name": name}, args.dry_run)
    result = post_announce(t, text, dry_run=args.dry_run, priority=True)
    if not args.dry_run:
        print("maintenance off; announce %s" % result)
    return 1 if result == "failed" else 0


def feed_text(t, entry):
    """The Cody line for one feed entry, or (None, why) when it is not posted."""
    kind, kind_type = entry.get("kind"), entry.get("type")
    if kind not in FEED_KINDS or kind_type not in ("start", "won"):
        return None, "not a public kind (%s %s)" % (kind, kind_type)
    if kind_type == "won" and (t.get("ANNOUNCE_EVENT_WINNERS") != "1" or kind == "hot_spot"):
        return None, "winner posts are off"
    if entry.get("by") != "scheduler" and t.get("ANNOUNCE_GM_EVENTS") != "1":
        return None, "GM-started event (ANNOUNCE_GM_EVENTS=0)"
    fields = {k: entry.get(k) for k in ("boss", "map", "region", "bonus", "ch", "player", "minutes")}
    fields["name"] = announce_name(t)
    return (kind, kind_type, fields), None


def cmd_announce_feed(t, args):
    path = args.file or t.get("ANNOUNCE_FILE")
    if not path:
        raise SystemExit("no announce feed (ANNOUNCE_FILE or --file)")
    state_path = os.path.join(t.state_dir, "announce-feed.json")
    state = load_json(state_path, None)
    try:
        st = os.stat(path)
    except OSError:
        if state is None and not args.dry_run:
            save_json(state_path, {"inode": 0, "offset": 0, "posted": []})
        print("no feed file %s yet" % path)
        return 0
    if state is None or args.seed:
        # First run: skip what is already in the file (no flood of old events).
        state = {"inode": st.st_ino, "offset": st.st_size, "posted": (state or {}).get("posted", [])}
        if not args.dry_run:
            save_json(state_path, state)
        print("seeded: %s up to byte %d marked as posted" % (path, st.st_size))
        return 0
    offset = state.get("offset", 0)
    if state.get("inode") != st.st_ino or st.st_size < offset:
        offset = 0  # replaced or truncated: read it again; the posted ids stop repeats
    posted = list(state.get("posted", []))
    with open(path, "rb") as f:
        f.seek(offset)
        data = f.read()
    code, now = 0, time.time()
    max_age = t.num("ANNOUNCE_MAX_AGE_MIN") * 60
    pos = 0
    while True:
        nl = data.find(b"\n", pos)
        if nl < 0:
            break  # a half-written last line waits for the next run
        raw = data[pos:nl].strip()
        line_end = nl + 1
        if raw:
            try:
                entry = json.loads(raw)
                if not isinstance(entry, dict):
                    raise ValueError
            except ValueError:
                t.log("[announce-feed] skipped a line that is not a JSON object")
                pos = line_end
                continue
            eid = str(entry.get("id") or hashlib.sha256(raw).hexdigest()[:16])
            if eid not in posted:
                made, why = feed_text(t, entry)
                at = entry.get("at")
                if made and isinstance(at, (int, float)) and max_age and now - at > max_age:
                    made, why = None, "stale (%s old)" % human_duration(now - at)
                if made is None:
                    t.log("[announce-feed] %s not posted: %s" % (eid, why))
                else:
                    kind, kind_type, fields = made
                    text = pick_cody(t, "%s_%s" % (kind, kind_type), fields, args.dry_run)
                    result = post_announce(t, text, dry_run=args.dry_run)
                    if result == "failed":
                        code = 1
                        break  # webhook down: keep this line for the next run
                if not args.dry_run:
                    posted = (posted + [eid])[-500:]
        pos = line_end
    if not args.dry_run:
        save_json(state_path, {"inode": st.st_ino, "offset": offset + pos, "posted": posted})
    return code


def cmd_test_webhook(t, args):
    kind = {"alerts": "ALERT", "status": "STATUS", "news": "NEWS", "announce": "ANNOUNCE"}[args.kind]
    deliver(t, kind, "[%s] test message from slumsms-monitor (%s webhook)" % (t.label, kind.lower()))
    print("sent" if t.webhook(kind) else "no %s webhook configured; written to %s" % (kind.lower(), t.log_path))
    return 0


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    c = sub.add_parser("check")
    c.add_argument("target")
    c.add_argument("--dry-run", action="store_true", help="print results and the message; change nothing")
    c.add_argument("--verbose", "-v", action="store_true")
    s = sub.add_parser("status")
    s.add_argument("target")
    s.add_argument("--dry-run", action="store_true")
    n = sub.add_parser("news")
    n.add_argument("target")
    n.add_argument("--file")
    n.add_argument("--seed", action="store_true", help="mark every current entry as posted")
    n.add_argument("--dry-run", action="store_true")
    w = sub.add_parser("test-webhook")
    w.add_argument("target")
    w.add_argument("kind", nargs="?", default="alerts", choices=["alerts", "status", "news", "announce"])
    a = sub.add_parser("announce", help="one public post, as written (or in Cody's voice with --cody)")
    a.add_argument("target")
    a.add_argument("text", nargs="+")
    a.add_argument("--cody", action="store_true", help="wrap the text in one of Cody's lines")
    a.add_argument("--dry-run", action="store_true")
    m = sub.add_parser("maintenance", help="MAINTENANCE_FILE on/off plus a public post")
    m.add_argument("target")
    m.add_argument("action", choices=["start", "end"])
    m.add_argument("--minutes", type=int, help="start: \"back in about N min\" (default MAINTENANCE_MINUTES)")
    m.add_argument("--reason", help="start: a short player-facing reason")
    m.add_argument("--no-announce", action="store_true", help="only switch the file, post nothing")
    m.add_argument("--dry-run", action="store_true")
    f = sub.add_parser("announce-feed", help="post new world event lines from ANNOUNCE_FILE")
    f.add_argument("target")
    f.add_argument("--file")
    f.add_argument("--seed", action="store_true", help="mark everything in the file as posted")
    f.add_argument("--dry-run", action="store_true")
    args = p.parse_args()
    t = Target(args.target)
    return {"check": cmd_check, "status": cmd_status, "news": cmd_news, "test-webhook": cmd_test_webhook,
            "announce": cmd_announce, "maintenance": cmd_maintenance, "announce-feed": cmd_announce_feed}[args.cmd](
        t, args)


if __name__ == "__main__":
    sys.exit(main())
