def fmt_since(ts):
    return dt.datetime.fromtimestamp(ts, dt.timezone.utc).strftime("%H:%M UTC")


def cmd_check(t, args):
    now = time.time()
    results = run_checks(t)
    state_path = os.path.join(t.state_dir, "checks.json")
    state = load_json(state_path, {"checks": {}, "sent": []})
    checks = state.setdefault("checks", {})
    alerts, recoveries, new_alert_keys = [], [], []
    remind = t.num("REMIND_MIN") * 60

    for r in results:
        if args.verbose or args.dry_run:
            print("%-6s %-16s %s" % ("skip" if r.skipped else ("ok" if r.ok else "FAIL"), r.name, r.detail))
        s = checks.setdefault(r.key, {"fails": 0, "alerted": False})
        s["detail"], s["name"], s["last_run"] = r.detail, r.name, now
        if r.skipped:
            continue  # neither a failure nor a recovery
        if r.ok:
            if s.get("alerted"):
                recoveries.append("**RECOVERED** %s: %s (was down %s)" % (
                    r.name, r.detail, human_duration(now - s.get("failing_since", now))))
            s.update(fails=0, alerted=False)
            s.pop("failing_since", None)
            s.pop("last_alert", None)
            continue
        s["fails"] = s.get("fails", 0) + 1
        s.setdefault("failing_since", now)
        need = int(t.get("FAIL_AFTER_" + r.key) or 1)
        if s["fails"] < need:
            continue
        if not s.get("alerted"):
            alerts.append("**ALERT** %s: %s (since %s)" % (r.name, r.detail, fmt_since(s["failing_since"])))
            s["alerted"], s["last_alert"] = True, now
            new_alert_keys.append(r.key)
        elif remind and now - s.get("last_alert", 0) >= remind:
            alerts.append("**STILL FAILING** %s: %s (for %s)" % (r.name, r.detail,
                                                                 human_duration(now - s["failing_since"])))
            s["last_alert"] = now

    # forget checks not run for a day (target config changed); ones not run because the server is down are kept
    for key in list(checks):
        if now - checks[key].get("last_run", now) > 86400:
            checks.pop(key)

    if alerts or recoveries:
        text = "[%s] " % t.label + "\n".join(alerts + recoveries)
        maint = t.get("MAINTENANCE_FILE")
        sent = [x for x in state.get("sent", []) if now - x < 3600]
        if args.dry_run:
            deliver(t, "ALERT", text, dry_run=True)
        elif maint and os.path.exists(maint):
            t.log("[alert, maintenance mode] " + scrub(text))
            # Not counted as alerted: if it is still failing once maintenance ends, it alerts then; if it
            # recovers during maintenance, no "recovered" message follows an alert nobody saw.
            for key in new_alert_keys:
                checks[key]["alerted"] = False
        elif len(sent) >= t.num("MAX_MESSAGES_PER_HOUR"):
            t.log("[alert, rate limited] " + scrub(text))
        else:
            try:
                deliver(t, "ALERT", text)
                sent.append(now)
            except RuntimeError:
                for key in new_alert_keys:  # logged locally; try the new alerts again next run
                    checks[key]["alerted"] = False
        state["sent"] = sent

    state["last_run"] = now
    if not args.dry_run:
        save_json(state_path, state)
        summary = {r.key: {"ok": r.ok, "skipped": r.skipped, "name": r.name, "detail": r.detail} for r in results}
        save_json(os.path.join(t.state_dir, "status.json"), {"at": int(now), "target": t.label, "checks": summary})
    return 0


def read_version(t):
    path = t.get("VERSION_FILE")
    if path and os.path.exists(path):
        with open(path) as f:
            first = f.readline().strip()
            if first:
                return first
    return t.get("VERSION") or "unknown"


def cmd_status(t, args):
    info = unit_info(t.get("UNIT"))
    up = bool(info and info["active"] == "active")
    port = int(t.num("LOGIN_PORT"))
    answers = up and login_answers(t.get("LOGIN_HOST"), port)[0]
    lines = ["**%s**" % t.get("STATUS_TITLE")]
    if answers:
        lines.append("Status: **Online**")
        players = bots = None
        db = Db(t)
        if t.get("DB_CONTAINER") and db.usable():
            try:
                # Real players only: logged-in accounts (2 = in game) that are not bot accounts.
                players = int(db.query(
                    "SELECT COUNT(*) FROM accounts a WHERE a.loggedin = 2 AND NOT EXISTS "
                    "(SELECT 1 FROM characters c WHERE c.accountid = a.id AND c.id >= %d)" % BOT_ID_BASE)[0][0])
                if t.get("STATUS_SHOW_BOTS") == "1":
                    bots = int(db.query("SELECT COUNT(*) FROM botroster WHERE Status='ACTIVE' "
                                        "AND LastLoginAt > LastLogoutAt")[0][0])
            except (RuntimeError, IndexError, ValueError):
                pass
        lines.append("Players online: %s" % ("?" if players is None else players))
        if bots is not None:
            lines.append("Bots online: %d" % bots)
        lines.append("Version: %s" % read_version(t))
        lines.append("Uptime: %s" % human_duration(info["up_seconds"] or 0))
    elif up:
        lines.append("Status: **Starting / not answering**")
        lines.append("Version: %s" % read_version(t))
    else:
        lines.append("Status: **Offline**")
    lines.append("Updated <t:%d:R>" % int(time.time()))
    content = "\n".join(lines)

    state_path = os.path.join(t.state_dir, "status-message.json")
    state = load_json(state_path, {})
    if args.dry_run:
        deliver(t, "STATUS", content, dry_run=True)
        return 0
    if not t.webhook("STATUS"):
        # Local log only when the online state changes, so the log does not grow every 5 minutes.
        key = "online" if answers else ("starting" if up else "offline")
        if state.get("local_state") != key:
            t.log("[status, no webhook configured] " + content.replace("\n", " | "))
            state["local_state"] = key
            save_json(state_path, state)
        return 0
    url_hash = hashlib.sha256(t.webhook("STATUS").encode()).hexdigest()[:12]
    mid = state.get("message_id") if state.get("webhook") == url_hash else None
    try:
        new_id = deliver(t, "STATUS", content, edit_id=mid, quiet=bool(mid))
    except RuntimeError as e:
        if mid and "HTTP 404" in str(e):  # the message was deleted: post a fresh one
            new_id = deliver(t, "STATUS", content)
        else:
            return 1
    state.update(message_id=new_id or mid, webhook=url_hash, updated=int(time.time()))
    save_json(state_path, state)
    return 0


def news_entries(path):
    data = load_json(path, None)
    if isinstance(data, dict):
        data = data.get("news")
    if not isinstance(data, list):
        raise SystemExit("no news array in %s" % path)
    return [e for e in data if isinstance(e, dict) and e.get("title")]


def news_key(entry):
    raw = json.dumps({k: entry.get(k) for k in ("title", "date", "body")}, sort_keys=True)
    return hashlib.sha256(raw.encode()).hexdigest()[:16]


def cmd_news(t, args):
    path = args.file or t.get("NEWS_FILE")
    if not path:
        raise SystemExit("no news file (NEWS_FILE or --file)")
    entries = news_entries(path)
    state_path = os.path.join(t.state_dir, "news.json")
    state = load_json(state_path, None)
    if state is None or args.seed:
        # First run: remember what is already out without posting it (no flood of old news).
        state = {"posted": sorted({news_key(e) for e in entries} | set((state or {}).get("posted", [])))}
        if not args.dry_run:
            save_json(state_path, state)
        print("seeded %d news entries as already posted" % len(entries))
        return 0
    posted = set(state.get("posted", []))
    fresh = [e for e in entries if news_key(e) not in posted]
    for entry in reversed(fresh):  # oldest first; the launcher lists newest first
        title = str(entry.get("title"))
        date = str(entry.get("date") or "")
        body = str(entry.get("body") or "")
        content = "**%s**%s\n%s" % (title, (" (%s)" % date) if date else "", body)
        try:
            deliver(t, "NEWS", content, dry_run=args.dry_run)
        except RuntimeError:
            return 1
        posted.add(news_key(entry))
        if not args.dry_run:
            save_json(state_path, {"posted": sorted(posted)})
    if not fresh:
        print("no new news entries")
    return 0


