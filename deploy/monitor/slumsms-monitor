class _Fields(dict):
    def __missing__(self, key):
        return "?"


def md_safe(value):
    """A value from the server or the command line, made inert for Discord: one line, no markdown, no mentions."""
    value = re.sub(r"\s+", " ", str(value if value is not None else "")).strip()[:120]
    value = re.sub(r"([\\*_~`|<>])", r"\\\1", value)
    return value.replace("@", "@\u200b") if value else "?"


def cody(key, fields, last=None, rng=random, raw=("text",)):
    """One Cody line for key (a CODY entry), filled from fields; avoids repeating `last` (that variant's index).
    Fields named in raw (the owner's own free text) go in as written. Returns (text, index)."""
    variants = CODY[key]
    choices = [i for i in range(len(variants)) if i != last] or list(range(len(variants)))
    i = rng.choice(choices)
    filled = {k: (str(v) if k in raw else md_safe(v)) for k, v in fields.items()}
    return variants[i].format_map(_Fields(filled)), i


def announce_name(t):
    return t.get("ANNOUNCE_NAME") or t.label


class _Lock:
    def __init__(self, path):
        self.path = path

    def __enter__(self):
        self.f = open(self.path, "a")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def post_announce(t, text, dry_run=False, priority=False, now=None):
    """One public post through the shared cap. priority (maintenance) skips the min gap but still counts toward and
    obeys the hourly cap. Returns "sent", "limited" or "failed" ("dry-run" in a dry run)."""
    now = time.time() if now is None else now
    text = scrub_public(text)
    state_path = os.path.join(t.state_dir, "announce.json")
    with _Lock(state_path + ".lock"):
        state = load_json(state_path, {})
        sent = [x for x in state.get("sent", []) if now - x < 3600]
        why = None
        if len(sent) >= t.num("ANNOUNCE_MAX_PER_HOUR"):
            why = "%d posts in the last hour (max %d)" % (len(sent), t.num("ANNOUNCE_MAX_PER_HOUR"))
        elif not priority and sent and now - max(sent) < t.num("ANNOUNCE_MIN_GAP_SEC"):
            why = "last post %ds ago (min gap %ds)" % (now - max(sent), t.num("ANNOUNCE_MIN_GAP_SEC"))
        if dry_run:
            print("[dry-run announce: %s]" % ("would be rate limited: " + why if why else "within the cap"))
            deliver(t, "ANNOUNCE", text, dry_run=True)
            return "dry-run"
        if why:
            t.log("[announce, rate limited: %s] %s" % (why, text))
            return "limited"
        try:
            deliver(t, "ANNOUNCE", text)
        except RuntimeError:
            return "failed"
        state["sent"] = sent + [now]
        save_json(state_path, state)
        return "sent"


def pick_cody(t, key, fields, dry_run=False):
    """cody() with the last variant per key remembered in announce.json, so repeats do not look canned."""
    state_path = os.path.join(t.state_dir, "announce.json")
    with _Lock(state_path + ".lock"):
        state = load_json(state_path, {})
        last = state.setdefault("last", {})
        text, i = cody(key, fields, last.get(key))
        if not dry_run:
            last[key] = i
            save_json(state_path, state)
    return text


def cmd_announce(t, args):
    text = " ".join(args.text).strip()
    if not text:
        raise SystemExit("nothing to announce")
    if args.cody:
        text = pick_cody(t, "free", {"text": text}, args.dry_run)
    result = post_announce(t, text, dry_run=args.dry_run)
    if result != "dry-run":
        print(result if t.webhook("ANNOUNCE") or result != "sent"
              else "no announce webhook configured; written to %s" % t.log_path)
    return 1 if result == "failed" else 0


