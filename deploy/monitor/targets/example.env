# /etc/slumsms-monitor/<target>.env  (root:root, mode 0600, NOT in git)
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
# Leave a line out (or empty) and those messages go to /var/log/slumsms-monitor/<target>.log only.
ALERT_WEBHOOK_URL=
STATUS_WEBHOOK_URL=
NEWS_WEBHOOK_URL=
# The PUBLIC player channel: maintenance notices and world events (as Cody). Empty: NEWS_WEBHOOK_URL is used.
# It never falls back to WEBHOOK_URL.
ANNOUNCE_WEBHOOK_URL=
# WEBHOOK_URL= is used for alerts, status and news when theirs is not set (meant for a private ops channel).
