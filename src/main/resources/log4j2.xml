<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" name="Cosmic" shutdownHook="disable">
    <Properties>
        <Property name="filename">cosmic-log</Property>
        <Property name="standard-pattern">%d{HH:mm:ss.SSS} [%t] %-5level %logger{2} - %msg%n</Property>
        <Property name="packet-pattern">%d{HH:mm:ss.SSS} %-15logger{1} - %msg%n</Property>
        <!-- BotLog.txt (soloMapling.BotLogger): same line format as the old hand-rolled writer. Rolled at
             botlog.maxSize or midnight into logs/botlog/ gzipped; rolled files older than botlog.maxAge or past
             botlog.maxTotal (compressed) are deleted. Override with -Dbotlog.maxSize=... etc. -->
        <Property name="botlog-pattern">[%d{yyyy-MM-dd HH:mm:ss}]: %msg%n</Property>
        <Property name="botlog-max-size">${sys:botlog.maxSize:-100 MB}</Property>
        <Property name="botlog-max-age">${sys:botlog.maxAge:-7d}</Property>
        <Property name="botlog-max-total">${sys:botlog.maxTotal:-700 MB}</Property>
        <!-- cosmic-log: rolled files (logs/yyyy-MM/yyyy-MM-dd/) were never deleted. -->
        <Property name="cosmic-log-max-age">${sys:cosmiclog.maxAge:-30d}</Property>
        <Property name="cosmic-log-max-total">${sys:cosmiclog.maxTotal:-2 GB}</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout>
                    <Pattern>${standard-pattern}</Pattern>
            </PatternLayout>
        </Console>

        <RollingFile name="File"
                     fileName="logs/${filename}.log"
                     filePattern="logs/$${date:yyyy-MM}/$${date:yyyy-MM-dd}/${filename}-%d{yyyy-MM-dd_HH-mm-ss}-%i.log">
            <PatternLayout>
                <Pattern>${standard-pattern}</Pattern>
            </PatternLayout>
            <Policies>
                <OnStartupTriggeringPolicy minSize="0"/>
                <SizeBasedTriggeringPolicy size="20 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="1000">
                <Delete basePath="logs" maxDepth="3">
                    <IfFileName glob="*/*/${filename}-*.log">
                        <IfAny>
                            <IfLastModified age="${cosmic-log-max-age}"/>
                            <IfAccumulatedFileSize exceeds="${cosmic-log-max-total}"/>
                        </IfAny>
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <RollingFile name="BotLogFile"
                     fileName="BotLog.txt"
                     filePattern="logs/botlog/BotLog-%d{yyyy-MM-dd}-%i.txt.gz">
            <PatternLayout>
                <Pattern>${botlog-pattern}</Pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="${botlog-max-size}"/>
            </Policies>
            <DefaultRolloverStrategy max="1000">
                <Delete basePath="logs/botlog" maxDepth="1">
                    <IfFileName glob="BotLog-*.txt.gz">
                        <IfAny>
                            <IfLastModified age="${botlog-max-age}"/>
                            <IfAccumulatedFileSize exceeds="${botlog-max-total}"/>
                        </IfAny>
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <Console name="PacketConsole" target="SYSTEM_OUT">
            <PatternLayout>
                <Pattern>${packet-pattern}</Pattern>
            </PatternLayout>
        </Console>

        <File name="MonitoredPacketFile" fileName="logs/monitored-packets.log">
            <PatternLayout>
                <Pattern>${standard-pattern}</Pattern>
            </PatternLayout>
        </File>

        <File name="TradeFile" fileName="logs/trades.log">
            <PatternLayout>
                <Pattern>${standard-pattern}</Pattern>
            </PatternLayout>
        </File>

        <File name="ExpeditionFile" fileName="logs/expeditions.log">
            <PatternLayout>
                <Pattern>${standard-pattern}</Pattern>
            </PatternLayout>
        </File>

        <File name="ChatFile" fileName="logs/chat.log">
            <PatternLayout>
                <Pattern>${standard-pattern}</Pattern>
            </PatternLayout>
        </File>

        <File name="GachaponFile" fileName="logs/gachapon.log">
            <PatternLayout>
                <Pattern>${standard-pattern}</Pattern>
            </PatternLayout>
        </File>

        <File name="MapleLeafFile" fileName="logs/mapleleaf.log">
            <PatternLayout>
                <Pattern>${standard-pattern}</Pattern>
            </PatternLayout>
        </File>
    </Appenders>

    <Loggers>
        <Root level="trace">
            <AppenderRef ref="File" level="debug"/>
            <AppenderRef ref="Console" level="trace"/>
        </Root>

        <Logger name="net.packet.logging" level="debug" additivity="false">
            <AppenderRef ref="PacketConsole"/>
            <AppenderRef ref="File"/>
        </Logger>
        <Logger name="net.packet.logging.MonitoredChrLogger" level="info" additivity="false">
            <AppenderRef ref="MonitoredPacketFile"/>
        </Logger>

        <Logger name="server.Trade" level="info" additivity="false">
            <AppenderRef ref="TradeFile"/>
        </Logger>
        <Logger name="server.expeditions.Expedition" level="info" additivity="false">
            <AppenderRef ref="ExpeditionFile"/>
        </Logger>
        <Logger name="server.ChatLogger" level="info" additivity="false">
            <AppenderRef ref="ChatFile"/>
        </Logger>
        <Logger name="server.gachapon.Gachapon" level="info" additivity="false">
            <AppenderRef ref="GachaponFile"/>
        </Logger>
        <Logger name="server.MapleLeafLogger" level="info" additivity="false">
            <AppenderRef ref="MapleLeafFile"/>
        </Logger>

        <Logger name="soloMapling.BotLog" level="info" additivity="false">
            <AppenderRef ref="BotLogFile"/>
        </Logger>

        <Logger name="com.zaxxer.hikari" level="info"/>
        <Logger name="io.netty" level="info"/>
    </Loggers>
</Configuration>