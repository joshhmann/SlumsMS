  "duplicate_names": {
    "rule": "Entities of one kind that share a name get display_name = name + ' (qualifier)'; the first of the group keeps the plain name (mobs: a normal-range, placed mob first; items: a non-cash item that drops, sells or is a reward; maps and NPCs: one with life or a placement; then the lowest id). Qualifiers, first unused wins: mobs 'event' (ids 9400000-9599999), 'party quest' (9300000-9399999), 'special' (9000000-9299999), 'boss' (WZ boss flag), then 'Lv. N'; items 'cash', category, 'Lv. N'; maps street name; NPCs first map placed; quests start NPC, 'Lv. N'; last resort '#id'. 'name' stays the raw String.wz name.",
    "labelled": {
      "items": 15305,
      "mobs": 3252,
      "maps": 3840,
      "npcs": 1070,
      "quests": 211
    }
  },
  "drop_rates": {
    "rates": {
      "world": 1,
      "drop_rate": 4,
      "boss_drop_rate": 3,
      "meso_rate": 10,
      "source": "TEST config.yaml worlds[id=1] (2026-10-26); live not read"
    },
    "summary": "Chances in this dataset are BASE chances. Bera multiplies mob drops by 4 (bosses by 3), quest items included, and reactor drops by 4. Global drops (NX cards, Maple Leaves, Chaos/White Scrolls, Flaming Feather) are NOT multiplied. Meso drops: the chance x4 (boss x3) and the amount x10.",
    "mob_drops": {
      "table": "drop_data (chance per 1,000,000)",
      "formula": "P = min(1, chance x rate x card / 999,999); rate = drop_rate, or boss_drop_rate when the mob has the boss flag (mobs.json 'boss')",
      "quest_items": "multiplied too (x4); a quest item only drops when a player who hit the mob needs it for that quest, and only that player sees it",
      "mesos": "item 0 rows: chance x rate as above, amount x meso_rate (10), x Meso Up when buffed",
      "equips": "may roll a rare godly version (GodlyDrops)",
      "bots": "bots roll the same table at the same world rates",
      "evidence": [
        "server/maps/MapleMap.java dropFromMonster: chRate = boss ? chr.getBossDropRate() : chr.getDropRate()",
        "server/maps/MapleMap.java dropItemsFromMonsterOnMap: dropChance = chance * chRate * cardRate; Randomizer.nextInt(999999) < dropChance",
        "server/maps/MapleMap.java MobLootEntry.run: quest entries use the same chRate",
        "client/Character.java setWorldRates / getBossDropRate",
        "server/loot/LootManager.java isRelevantDrop (USE_SPAWN_RELEVANT_LOOT: quest items need a player who needs them)",
        "soloMapling/ArtificialPlayer/BotAttackSystem/BotAttackEffects.java dropMobLoot (bots: world rates)"
      ]
    },
    "global_drops": {
      "table": "drop_data_global (chance per 1,000,000; items.json 'global_drops')",
      "formula": "P = chance / 999,999, no drop rate, no boss rate; quantity scales with the mob's max HP",
      "evidence": [
        "server/maps/MapleMap.java dropGlobalItemsFromMonsterOnMap: Randomizer.nextInt(999999) < de.chance"
      ]
    },
    "reactor_drops": {
      "table": "reactordrops (chance = 1 in N)",
      "formula": "P = min(1, drop_rate / N) using the player's drop rate (no boss rate)",
      "evidence": [
        "scripting/reactor/ReactorActionManager.java generateDropList: Math.random() < dropRate / chance"
      ]
    },
    "other_multipliers": "item drop cards (ITEM_UP_BY_ITEM buffs), the Showdown debuff, and drop coupons (none sold in 1.5.1+) multiply mob drops; friendly mobs (escort events) use x1; USE_ADD_RATES_BY_LEVEL is off"
  },
  "notes": {
    "weapon_magic_attack": "Weapons: in SlumsMS's (MapleRoot) WZ every v83 weapon has incMAD equal to incPAD (e.g. Maple Kandayo 1472032: 74/74; upstream Cosmic: 23 attack, no magic attack). The shipped client Data/Character/Weapon has the same values, and the server adds equip incMAD to total magic attack (Character.recalcLocalStats), so the in-game tooltip and stats show it. The dataset keeps the values as the game uses them. It only matters to magic attacks: a claw's magic attack does nothing for a thief, but a magician can hold a no-job-requirement weapon for magic attack."
  }
