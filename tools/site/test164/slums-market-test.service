[Unit]
Description=SlumsMS TEST website market (watchlist, alerts, Buy/Sell board), 127.0.0.1:8195
After=network.target slums-login-test.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/slums-site-test/tools/site/market_service.py
Environment=SLUMS_LOGIN_KEY_FILE=/etc/slums-login-test/key
Environment=SLUMS_LOGIN_REVOKED=/var/lib/slums-login-test/revoked.txt
Environment=SLUMS_MARKET_DB=/var/lib/slums-market-test/market.db
# the TEST server's board folders (its -Dslums.board.inbox/outbox)
Environment=SLUMS_MARKET_INBOX=/opt/mapleroot-dev/persistence-test/site-board/inbox
Environment=SLUMS_MARKET_OUTBOX=/opt/mapleroot-dev/persistence-test/site-board/outbox
Environment=SLUMS_MARKET_ITEMS=/srv/slums-site-test/database/search-index.json
Environment=SLUMS_MARKET_UNTRADEABLE=/srv/slums-site-test/market/untradeable.json
Environment=SLUMS_MARKET_PORT=8195
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/slums-market-test /opt/mapleroot-dev/persistence-test/site-board
ReadOnlyPaths=/etc/slums-login-test /var/lib/slums-login-test /srv/slums-site-test /opt/slums-site-test
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryMax=128M
UMask=0027

[Install]
WantedBy=multi-user.target
