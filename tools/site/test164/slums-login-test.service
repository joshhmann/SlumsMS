[Unit]
Description=SlumsMS TEST website sign-in (TEST game accounts, invite sign-up), 127.0.0.1:8194
After=network.target

[Service]
Type=simple
# root only because the throwaway TEST key is root-only (mode 600); the sandbox below still applies
ExecStart=/usr/bin/python3 /opt/slums-site-test/tools/site/login_service.py
Environment=SLUMS_LOGIN_KEY_FILE=/etc/slums-login-test/key
Environment=SLUMS_LOGIN_REVOKED=/var/lib/slums-login-test/revoked.txt
Environment=SLUMS_LOGIN_PORT=8194
# plain http on the LAN: a Secure cookie would never be sent back
Environment=SLUMS_LOGIN_SECURE=0
# ticket 105: the TEST game server's auth API, its secret (made by the release lead) and our own address salt
Environment=SLUMS_LOGIN_AUTH_URL=http://127.0.0.1:8196
Environment=SLUMS_LOGIN_AUTH_SECRET_FILE=/etc/slums-auth-test/secret
Environment=SLUMS_LOGIN_IP_SALT_FILE=/etc/slums-login-test/ip-salt
# ticket 106: TEST's own download-pass key (made by install.sh), never Live's
Environment=SLUMS_LOGIN_PASS_KEY_FILE=/etc/slums-login-test/pass-key
# 1.6.2 ticket 157: the TEST game's read-only bot inspect (-Dslums.inspect.port=8198, -Dslums.inspect.secretFile=
# /etc/slums-inspect-test/secret, made by install.sh) for the staff Bots page; until the game listens it answers 503
Environment=SLUMS_LOGIN_INSPECT_URL=http://127.0.0.1:8198
Environment=SLUMS_LOGIN_INSPECT_SECRET_FILE=/etc/slums-inspect-test/secret
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/slums-login-test
ReadOnlyPaths=/opt/slums-site-test /etc/slums-login-test -/etc/slums-auth-test -/etc/slums-inspect-test
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryMax=128M
UMask=0027

[Install]
WantedBy=multi-user.target
