[Unit]
Description=SlumsMS TEST website sign-in (codes typed on the TEST server), 127.0.0.1:8194
After=network.target

[Service]
Type=simple
# root only because the throwaway TEST key is root-only (mode 600); the sandbox below still applies
ExecStart=/usr/bin/python3 /opt/slums-site-test/tools/site/login_service.py
Environment=SLUMS_LOGIN_KEY_FILE=/etc/slums-login-test/key
Environment=SLUMS_LOGIN_APPROVALS=/var/lib/slums-login-test/approvals
Environment=SLUMS_LOGIN_REVOKED=/var/lib/slums-login-test/revoked.txt
Environment=SLUMS_LOGIN_PORT=8194
# plain http on the LAN: a Secure cookie would never be sent back
Environment=SLUMS_LOGIN_SECURE=0
# ticket 105: the TEST game server's auth API, its secret (made by the release lead) and our own address salt
Environment=SLUMS_LOGIN_AUTH_URL=http://127.0.0.1:8196
Environment=SLUMS_LOGIN_AUTH_SECRET_FILE=/etc/slums-auth-test/secret
Environment=SLUMS_LOGIN_IP_SALT_FILE=/etc/slums-login-test/ip-salt
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/slums-login-test
ReadOnlyPaths=/opt/slums-site-test /etc/slums-login-test -/etc/slums-auth-test
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryMax=128M
UMask=0027

[Install]
WantedBy=multi-user.target
