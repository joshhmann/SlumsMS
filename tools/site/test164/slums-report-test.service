[Unit]
Description=SlumsMS TEST website report form receiver, 127.0.0.1:8193 (staff reader 8197)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/slums-site-test/tools/site/report_service.py
# TEST's own reports file and salt (made by install.sh), never live's /var/lib/slums-feedback or /etc/slums-report
Environment=SLUMS_REPORT_FILE=/var/lib/slums-report-test/reports.jsonl
Environment=SLUMS_REPORT_SALT_FILE=/etc/slums-report-test/salt
Environment=SLUMS_REPORT_PORT=8193
# no Caddy in front: the TEST nginx sets X-Forwarded-For to the visitor itself
Environment=SLUMS_REPORT_PROXY_HOPS=0
# versions stamped on each report: the TEST server's site export and the TEST site's build (read only)
# the World build's copy, the same file live reads (b064): the version only, no commit
Environment=SLUMS_REPORT_WORLD_FILE=/srv/slums-site-test/world/online.json
Environment=SLUMS_REPORT_SITE_BUILD=/srv/slums-site-test/assets/build.json
# the staff Reports tab's reader (admin/reports), reached only through nginx's GM-3 guard
Environment=SLUMS_REPORT_STAFF_PORT=8197
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/slums-report-test
ReadOnlyPaths=/etc/slums-report-test /opt/slums-site-test
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryMax=128M
UMask=0027

[Install]
WantedBy=multi-user.target
