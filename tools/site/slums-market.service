[Unit]
Description=SlumsMS website: watchlist, price alerts and the Buy/Sell board for signed-in players
After=network.target slums-login.service

[Service]
Type=simple
User=slums-market
Group=slums-market
# reads the sign-in key (group slums-login), never writes it
SupplementaryGroups=slums-login
# 1.6.2: the Flask app (python3-flask, already on 164 for TEST); same URLs, cookie and port as market_service.py,
# which stays the rollback. The Slums Exchange opens in 1.6.2 (owner, 2026-10-30; audit W1): install this unit on
# release night only after the 1.6.2 game is up (DEPLOY.md 3b), since the page asks the game for every order.
ExecStart=/usr/bin/python3 /opt/slums-site-build/tools/site/market_app.py
Environment=SLUMS_MARKET_EXCHANGE=on
Environment=SLUMS_LOGIN_KEY_FILE=/etc/slums-login/key
Environment=SLUMS_LOGIN_REVOKED=/var/lib/slums-login/revoked.txt
Environment=SLUMS_MARKET_DB=/var/lib/slums-market/market.db
# the game server (root) reads the inbox and writes the outbox; both live here because Server/ is root-only
Environment=SLUMS_MARKET_INBOX=/var/lib/slums-market/inbox
Environment=SLUMS_MARKET_OUTBOX=/var/lib/slums-market/outbox
Environment=SLUMS_MARKET_ITEMS=/srv/slums-site/database/search-index.json
Environment=SLUMS_MARKET_UNTRADEABLE=/srv/slums-site/market/untradeable.json
Environment=SLUMS_MARKET_PORT=8095
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/slums-market
ReadOnlyPaths=/etc/slums-login /var/lib/slums-login /srv/slums-site /opt/slums-site-build
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryMax=128M
UMask=0027

[Install]
WantedBy=multi-user.target
