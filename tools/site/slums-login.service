[Unit]
Description=SlumsMS website sign-in (codes typed in game)
After=network.target

[Service]
Type=simple
User=slums-login
Group=slums-login
ExecStart=/usr/bin/python3 /opt/slums-login/login_service.py
Environment=SLUMS_LOGIN_KEY_FILE=/etc/slums-login/key
Environment=SLUMS_LOGIN_APPROVALS=/var/lib/slums-login/approvals
Environment=SLUMS_LOGIN_REVOKED=/var/lib/slums-login/revoked.txt
Environment=SLUMS_LOGIN_PORT=8094
# ticket 105: the game server's auth API, its secret and the address salt (both made by the owner, LAUNCH step 2)
Environment=SLUMS_LOGIN_AUTH_URL=http://127.0.0.1:8186
Environment=SLUMS_LOGIN_AUTH_SECRET_FILE=/etc/slums-auth/secret
Environment=SLUMS_LOGIN_IP_SALT_FILE=/etc/slums-login/ip-salt
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/slums-login
ReadOnlyPaths=-/etc/slums-auth
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryMax=128M
UMask=0027

[Install]
WantedBy=multi-user.target
