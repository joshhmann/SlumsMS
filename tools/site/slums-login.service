[Unit]
Description=SlumsMS website sign-in (game username and password, invite sign-up)
After=network.target

[Service]
Type=simple
User=slums-login
Group=slums-login
ExecStart=/usr/bin/python3 /opt/slums-login/login_service.py
Environment=SLUMS_LOGIN_KEY_FILE=/etc/slums-login/key
Environment=SLUMS_LOGIN_REVOKED=/var/lib/slums-login/revoked.txt
Environment=SLUMS_LOGIN_PORT=8094
# ticket 105: the game server's auth API, its secret and the address salt (both made by the owner, LAUNCH step 2)
Environment=SLUMS_LOGIN_AUTH_URL=http://127.0.0.1:8186
Environment=SLUMS_LOGIN_AUTH_SECRET_FILE=/etc/slums-auth/secret
Environment=SLUMS_LOGIN_IP_SALT_FILE=/etc/slums-login/ip-salt
# 1.6.2 ticket 157: the staff Bots page's bot inspect. OFF on live: it needs the owner's go and the game started with
# -Dslums.inspect=true -Dslums.inspect.port=8098 -Dslums.inspect.secretFile=/etc/slums-inspect/secret (that file
# readable by group slums-login). Then uncomment both lines and add -/etc/slums-inspect to ReadOnlyPaths.
#Environment=SLUMS_LOGIN_INSPECT_URL=http://127.0.0.1:8098
#Environment=SLUMS_LOGIN_INSPECT_SECRET_FILE=/etc/slums-inspect/secret
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/slums-login
ReadOnlyPaths=-/etc/slums-auth
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryMax=128M
UMask=0027

[Install]
WantedBy=multi-user.target
