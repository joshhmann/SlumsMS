#!/usr/bin/env bash
# e08 login probe schedule. Runs qa-scripts/e08-login-probe.yaml TRIES times in a row at each measuring point, starting
# OFFSET minutes after T0 (the timestamp of the TEST journal line "[Director] boot fill:"), and writes one CSV row per try
# with the runner's own start and end UTC. The measurement itself is the TEST hex logger's server timestamps (login request
# to first map packet): join them to these rows by time. Nothing here parses the logger.
#
#   tools/qa/e08-probe <label> <T0 "YYYY-MM-DD HH:MM:SS" UTC> [--offsets "2 10 20"] [--tries 5] [--out FILE] [--dry-run]
#
# Baseline (a quiet server): pass --offsets "0" and T0 = now. Env: RUNNER (default tools/qa-runner/run), SCRIPT
# (default qa-scripts/e08-login-probe.yaml), CLIENT_MCP_TARGET (default vm = tarkov2). A failed try is a row (exit != 0),
# never retried. Columns: run,minute_since_fill_start,try,runner_start_utc,runner_end_utc,runner_exit
set -u
LABEL=${1:?label}; T0=${2:?T0}; shift 2
OFFSETS="2 10 20"; TRIES=5; OUT=""; DRY=0
while [ $# -gt 0 ]; do case $1 in
  --offsets) OFFSETS=$2; shift;; --tries) TRIES=$2; shift;; --out) OUT=$2; shift;; --dry-run) DRY=1;;
  *) echo "unknown option $1" >&2; exit 2;; esac; shift; done
RUNNER=${RUNNER:-tools/qa-runner/run}; SCRIPT=${SCRIPT:-qa-scripts/e08-login-probe.yaml}
export CLIENT_MCP_TARGET=${CLIENT_MCP_TARGET:-vm}
t0=$(date -u -d "$T0 UTC" +%s) || { echo "bad T0 '$T0'" >&2; exit 2; }
[ -n "$OUT" ] || OUT="e08-$LABEL-$(date -u +%Y%m%dT%H%M%SZ).csv"
echo "run,minute_since_fill_start,try,runner_start_utc,runner_end_utc,runner_exit" > "$OUT"
for off in $OFFSETS; do
  due=$((t0 + off*60)); now=$(date -u +%s)
  echo "point $LABEL +${off} min: first login due $(date -u -d @$due +%H:%M:%S) UTC (in $((due-now)) s)" >&2
  [ "$DRY" = 1 ] && continue
  [ "$due" -gt "$now" ] && sleep $((due-now))
  for try in $(seq 1 "$TRIES"); do
    s=$(date -u +%H:%M:%S); "$RUNNER" "$SCRIPT" >/dev/null 2>"$OUT.err"; rc=$?; e=$(date -u +%H:%M:%S)
    echo "$LABEL,$off,$try,$s,$e,$rc" >> "$OUT"
  done
done
echo "wrote $OUT" >&2
