#!/bin/bash
# Start an auto-QA run on the TEST server without logging in to the game.
#
#   tools/ops/autoqa-run [--feature] [all|smoke|<check id or family>|<id,id,...>] [--fast] [--failed] [--release]
#
#   --fast    run the suite with the QA clock at 0.4x: the staged waits (guild boss-run gathering and inside time,
#             buddy/pending accept windows, settle windows) are 40% as long. Checks that assert a real timer, a
#             cooldown or an expiry are not scaled, and every result says it ran in the fast lane.
#   --failed  rerun only the checks whose last result was not a PASS and carry the rest forward, labelled not-rerun.
#             Refused (so everything runs) when the server was redeployed since that run, when the fast/normal mode
#             changed, or when the earlier run recorded no results. For iterating; evidence comes from a full run.
#   --release a RELEASE run (b222): every check, fresh, normal clock; the run FAILs overall on any FAIL or on any SKIP
#             not on the allow-list (src/main/resources/soloMapling/autoqa-release-skips.tsv, the client-only checks).
#             The run line in latest.json and test-status say "release: PASS" or "release: FAIL (unexpected SKIP: ids)".
#             Needs the selector all; refused with --fast or --failed.
#   --feature target the isolated bot-brain copy (/opt/mapleroot-dev/bot-life-160) instead of TEST.
#
# Appends the request to the queue Server/data/autoqa/run-queue.txt (b016: one line "<id> TAB <UTC stamp> TAB <request>",
# atomic append) and prints "queued (#n, position k)". The server takes the requests in order, each one 30 s or less
# after the previous run ends (logged as "Auto-QA run request"); a run in progress is not interrupted and a second
# request no longer replaces the first. Results: tools/ops/test-status. Never run it against TEST for a quick look:
# every call is a real run request.
set -euo pipefail
SEL=""
FLAGS=""
BASE=/opt/mapleroot-dev/persistence-test
for arg in "$@"; do
    case "$arg" in
        --fast|--failed|--release) FLAGS="$FLAGS $arg" ;;
        --feature) BASE=/opt/mapleroot-dev/bot-life-160 ;;
        -*) echo "bad option: $arg" >&2; exit 2 ;;
        *) [[ -z "$SEL" ]] || { echo "one selector only: $SEL $arg" >&2; exit 2; }; SEL="$arg" ;;
    esac
done
if [[ "$FLAGS" == *--release* ]]; then
    SEL="${SEL:-all}"
    [[ "$SEL" == all ]] || { echo "a release run covers every check: use all, not $SEL" >&2; exit 2; }
    [[ "$FLAGS" != *--fast* && "$FLAGS" != *--failed* ]] || { echo "a release run refuses --fast and --failed" >&2; exit 2; }
fi
SEL="${SEL:-smoke}"
[[ "$SEL" =~ ^[A-Za-z0-9,_-]+$ ]] || { echo "bad selector: $SEL" >&2; exit 2; }
REQ="$SEL$FLAGS"
# enqueue <dir> <request>: runs where the data dir is (over ssh, or locally with AUTOQA_LOCAL_DIR for the shell test).
enqueue() {
    local dir="$1" req="$2" n k stamp
    mkdir -p "$dir"
    exec 9>"$dir/.run-queue.lock"
    flock 9
    n=$(( $(cat "$dir/run-queue.seq" 2>/dev/null || echo 0) + 1 ))
    echo "$n" > "$dir/run-queue.seq"
    stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    printf '%s\t%s\t%s\n' "$n" "$stamp" "$req" >> "$dir/run-queue.txt"
    k=$(cat "$dir/run-queue.txt" "$dir/run-queue.work" 2>/dev/null | grep -c . || true)
    echo "queued (#$n, position $k) '$req'"
}
if [[ -n "${AUTOQA_LOCAL_DIR:-}" ]]; then
    enqueue "$AUTOQA_LOCAL_DIR" "$REQ"
else
    ssh root@192.168.0.164 "$(declare -f enqueue); enqueue '$BASE/Server/data/autoqa' '$REQ'"
fi
echo "the test server starts it within 30 s of the earlier runs ending"
