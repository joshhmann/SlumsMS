#!/bin/bash
# Deploy this checkout to the TEST server (never live). Builds the jar, copies it plus every runtime data file that
# changed since the last test deploy, applies pending migrations, restarts the test unit and checks the boot.
#
#   tools/ops/deploy-test [--feature] [--skip-build] [--dry-run] [--since <commit>] [--no-migrations]
# --feature targets only /opt/mapleroot-dev/bot-life-160 (slums-life160 / mapleroot_life160); never shared TEST/live.
#
# What it touches, all on TEST (root@$SLUMS_TEST_HOST, default 192.168.0.111 = mapletest since the 1.6.3 cutover):
#   /opt/mapleroot-dev/persistence-test/Server/   target/Cosmic.jar, scripts/**, src/main/** (non-.java), cashshop/
#   docker container mapleroot-integration-db, schema mapleroot_persist  (migrations from database/migrations, ledger
#   table mapleroot_integration_migrations; only ids not already in the ledger, in name order)
#   unit slums-persistence-test, restarted through /opt/mapleroot-dev/persistence-test/start-test.sh
# Backups go to /opt/mapleroot-dev/persistence-test/deploys/<UTC stamp>/ (old jar, replaced files, DB dump when a
# migration runs). The deployed commit is written to Server/DEPLOYED_COMMIT, which the next run diffs against.
#
# Rules: this script refuses to run against the live paths, never reads or prints keys, and stops if the boot shows
# ERROR/Exception lines. A running auto-QA or a GM testing on the server is interrupted by the restart: ask first.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"   # TEST_HOST, test_ssh, test_scp

BASE=/opt/mapleroot-dev/persistence-test
SRV=$BASE/Server
UNIT=slums-persistence-test
DBC=mapleroot-integration-db
DBN=mapleroot_persist

SKIP_BUILD=0; DRY=0; SINCE=""; MIGRATE=1
while [ $# -gt 0 ]; do
  case "$1" in
    --feature) BASE=/opt/mapleroot-dev/bot-life-160; SRV=$BASE/Server; UNIT=slums-life160; DBN=mapleroot_life160 ;;
    --skip-build) SKIP_BUILD=1 ;;
    --dry-run) DRY=1 ;;
    --since) SINCE="$2"; shift ;;
    --no-migrations) MIGRATE=0 ;;
    -h|--help) sed -n '2,17p' "$0"; exit 0 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

cd "$(git rev-parse --show-toplevel)"
case "$SRV" in *"/opt/mapleroot/"*|*"Full Repack"*) echo "refusing: that is the live server" >&2; exit 1 ;; esac
HEAD=$(git rev-parse --short=9 HEAD)
VERSION=$(sed -n 's/.*SLUMSMS_VERSION = "\(.*\)".*/\1/p' src/main/java/constants/net/ServerConstants.java)
echo "== deploy-test: $VERSION at $HEAD to root@$TEST_HOST =="

if [ -z "$SINCE" ]; then
  SINCE=$(test_ssh "cat $SRV/DEPLOYED_COMMIT 2>/dev/null || true")
  [ -n "$SINCE" ] || { echo "no $SRV/DEPLOYED_COMMIT on the server: pass --since <commit the server runs>" >&2; exit 1; }
fi
git cat-file -e "$SINCE^{commit}" 2>/dev/null || { echo "commit $SINCE not in this checkout (git fetch?)" >&2; exit 1; }
echo "server runs $SINCE; changes since then:"

# runtime data the server reads from disk (the jar carries the .java)
mapfile -t DATA < <(git diff --name-only --diff-filter=AM "$SINCE" HEAD -- scripts src/main cashshop \
  | grep -v '\.java$' || true)
mapfile -t GONE < <(git diff --name-only --diff-filter=D "$SINCE" HEAD -- scripts src/main cashshop \
  | grep -v '\.java$' || true)
mapfile -t MIGS < <(git diff --name-only --diff-filter=A "$SINCE" HEAD -- database/migrations \
  | grep -v '\.rollback\.sql$' | grep '\.sql$' | sort || true)
printf '  data: %s\n' "${#DATA[@]} changed, ${#GONE[@]} deleted"; for f in "${DATA[@]}" "${GONE[@]}"; do echo "    $f"; done
printf '  migrations: %s\n' "${#MIGS[@]}"; for f in "${MIGS[@]}"; do echo "    $f"; done
[ $DRY = 1 ] && { echo "dry run: nothing changed"; exit 0; }

if [ $SKIP_BUILD = 0 ]; then
  [ -f config.yaml ] || cp config.example.yaml config.yaml
  echo "building (tests skipped here: run mvn -q -o test before deploying)"
  mvn -q -o -DskipTests package
fi
JAR=target/Cosmic.jar
SHA=$(sha256sum $JAR | cut -c1-16)
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
D=$BASE/deploys/$STAMP
echo "jar $SHA -> $D"

test_ssh "mkdir -p $D/files"
test_scp -q "$JAR" "root@$TEST_HOST:$D/Cosmic.jar"
if [ ${#DATA[@]} -gt 0 ]; then tar czf /tmp/deploy-test-$$.tgz "${DATA[@]}"; test_scp -q "/tmp/deploy-test-$$.tgz" "root@$TEST_HOST:$D/data.tgz"; rm -f /tmp/deploy-test-$$.tgz; fi
for m in "${MIGS[@]}"; do test_scp -q "$m" "root@$TEST_HOST:$D/files/"; done
printf '%s\n' "${GONE[@]}" | test_ssh "cat > $D/deleted.txt"
echo "$HEAD $VERSION $SHA" | test_ssh "cat > $D/DEPLOY.txt"

test_ssh bash -s -- "$D" "$HEAD" "$MIGRATE" "$BASE" "$UNIT" "$DBN" < "$(dirname "$0")/deploy-test-remote.sh"
echo "done: test server runs $VERSION ($HEAD), backups in $D"
