#!/bin/bash
# Deploy this checkout to the TEST server (never live). Builds the jar, copies it plus every runtime data file that
# changed since the last test deploy, applies pending migrations, restarts the test unit and checks the boot.
#
#   tools/ops/deploy-test [--instance A|B|C] [--commit <sha>] [--force] [--feature] [--skip-build] [--dry-run]
#                         [--since <commit>] [--no-migrations] [--start-script]
# --instance picks the TEST server (default A = today's slums-persistence-test, so existing calls behave as before).
#   B (slums-test-b) and C (slums-test-c) run beside A with their own folder, ports, DB container and start script
#   (docs/ops/test-instances.md, values from tools/ops/test-instances.py). One call, one target: only that instance's
#   unit is restarted, only its DB gets migrations, only its boot is checked. An unknown instance is refused.
#   C only takes the commit in deploy/test/test-c.pin (the frozen release candidate) unless --force.
# --commit <sha> asserts the checkout is at that commit (the build is always this checkout's HEAD).
# --feature targets only /opt/mapleroot-dev/bot-life-160 (slums-life160 / mapleroot_life160); never shared TEST/live.
# --start-script installs deploy/test/start-test.sh as TEST's start script (old one kept beside it). Without it the
#   deploy only warns when they differ. 1.6.6 flag parity: TEST's -D flags are kept in the repo and checked against
#   live with tools/ops/flag-parity (a warning here; tools/release/stage refuses).
#
# What it touches, all on TEST (root@$SLUMS_TEST_HOST, default 192.168.0.111 = mapletest since the 1.6.3 cutover):
#   /opt/mapleroot-dev/persistence-test/Server/   target/Cosmic.jar, scripts/**, src/main/** (non-.java), cashshop/
#   docker container mapleroot-integration-db, schema mapleroot_persist  (migrations from database/migrations, ledger
#   table mapleroot_integration_migrations; only ids not already in the ledger, in name order)
#   unit slums-persistence-test, restarted through /opt/mapleroot-dev/persistence-test/start-test.sh
# Backups go to /opt/mapleroot-dev/persistence-test/deploys/<UTC stamp>/ (old jar, replaced files, DB dump when a
# migration runs). The deployed commit is written to Server/DEPLOYED_COMMIT, which the next run diffs against.
#
# Rules: this script refuses to run against the live paths, never reads or prints keys, and stops if the boot shows
# ERROR/Exception lines. A running auto-QA or a GM testing on the server is interrupted by the restart: ask first.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"   # TEST_HOST, test_ssh, test_scp

BASE=/opt/mapleroot-dev/persistence-test
SRV=$BASE/Server
UNIT=slums-persistence-test
DBC=mapleroot-integration-db
DBN=mapleroot_persist

SKIP_BUILD=0; DRY=0; SINCE=""; MIGRATE=1; START_SCRIPT=0; INSTANCE=A; FEATURE=0; FORCE=0; WANT_COMMIT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --feature) FEATURE=1; BASE=/opt/mapleroot-dev/bot-life-160; SRV=$BASE/Server; UNIT=slums-life160; DBN=mapleroot_life160 ;;
    --instance) [ $# -ge 2 ] || { echo "--instance needs A, B or C" >&2; exit 2; }; INSTANCE="$2"; shift ;;
    --commit) [ $# -ge 2 ] || { echo "--commit needs a sha" >&2; exit 2; }; WANT_COMMIT="$2"; shift ;;
    --force) FORCE=1 ;;
    --skip-build) SKIP_BUILD=1 ;;
    --dry-run) DRY=1 ;;
    --since) SINCE="$2"; shift ;;
    --no-migrations) MIGRATE=0 ;;
    --start-script) START_SCRIPT=1 ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

cd "$(git rev-parse --show-toplevel)"
# the instance table lives in tools/ops/test-instances.py (one source for this script, the tests and test-instance)
case "$INSTANCE" in A|B|C) ;; *) echo "unknown instance '$INSTANCE': use A, B or C" >&2; exit 2 ;; esac
if [ $FEATURE = 1 ] && [ "$INSTANCE" != A ]; then echo "--feature cannot be combined with --instance $INSTANCE" >&2; exit 2; fi
inst() { python3 tools/ops/test-instances.py get "$INSTANCE" "$1"; }
START_SRC=deploy/test/start-test.sh
if [ $FEATURE = 0 ]; then
  BASE=$(inst folder); SRV=$BASE/Server; UNIT=$(inst unit); DBC=$(inst db_container); DBN=$(inst db_name)
  START_SRC=$(inst start_script)
fi
case "$SRV" in *"/opt/mapleroot/"*|*"Full Repack"*) echo "refusing: that is the live server" >&2; exit 1 ;; esac
HEAD=$(git rev-parse --short=9 HEAD)
VERSION=$(sed -n 's/.*SLUMSMS_VERSION = "\(.*\)".*/\1/p' src/main/java/constants/net/ServerConstants.java)
HEAD_FULL=$(git rev-parse HEAD)
if [ -n "$WANT_COMMIT" ]; then
  want_full=$(git rev-parse --verify -q "$WANT_COMMIT^{commit}" || true)
  [ -n "$want_full" ] && [ "$want_full" = "$HEAD_FULL" ] || { echo "--commit $WANT_COMMIT is not the checked-out HEAD $HEAD: check it out first" >&2; exit 1; }
fi
if [ "$INSTANCE" = C ] && [ $FORCE = 0 ]; then
  PIN_FILE=${DEPLOY_TEST_PIN_FILE:-deploy/test/test-c.pin}
  pin=$(sed 's/#.*//' "$PIN_FILE" 2>/dev/null | tr -d '[:space:]' || true)
  case "$pin" in
    [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*) ;;   # at least 7 hex digits: no empty or tiny wildcard
    *) echo "refusing: $PIN_FILE has no usable pinned commit (TEST-C only takes the pinned release candidate; --force overrides)" >&2; exit 1 ;;
  esac
  case "$HEAD_FULL" in
    "$pin"*) ;;
    *) echo "refusing: TEST-C is pinned to $pin (deploy/test/test-c.pin), this checkout is $HEAD. Check out the pinned commit, change the pin on the Coordinator's word, or pass --force" >&2; exit 1 ;;
  esac
fi
[ "$INSTANCE" = C ] && [ $FORCE = 1 ] && echo "  WARN --force: TEST-C pin ignored"
echo "== deploy-test: $VERSION at $HEAD to root@$TEST_HOST (instance $INSTANCE: unit $UNIT, $BASE, db $DBC/$DBN) =="

if [ -z "$SINCE" ]; then
  SINCE=$(test_ssh "cat $SRV/DEPLOYED_COMMIT 2>/dev/null || true")
  [ -n "$SINCE" ] || { echo "no $SRV/DEPLOYED_COMMIT on the server: pass --since <commit the server runs>" >&2; exit 1; }
fi
git cat-file -e "$SINCE^{commit}" 2>/dev/null || { echo "commit $SINCE not in this checkout (git fetch?)" >&2; exit 1; }
echo "server runs $SINCE; changes since then:"

# runtime data the server reads from disk (the jar carries the .java)
mapfile -t DATA < <(git diff --name-only --diff-filter=AM "$SINCE" HEAD -- scripts src/main cashshop \
  | grep -v '\.java$' || true)
mapfile -t GONE < <(git diff --name-only --diff-filter=D "$SINCE" HEAD -- scripts src/main cashshop \
  | grep -v '\.java$' || true)
mapfile -t MIGS < <(git diff --name-only --diff-filter=A "$SINCE" HEAD -- database/migrations \
  | grep -v '\.rollback\.sql$' | grep '\.sql$' | sort || true)
printf '  data: %s\n' "${#DATA[@]} changed, ${#GONE[@]} deleted"; for f in "${DATA[@]}" "${GONE[@]}"; do echo "    $f"; done
printf '  migrations: %s\n' "${#MIGS[@]}"; for f in "${MIGS[@]}"; do echo "    $f"; done
# 1.6.6 flag parity: the start script TEST runs is the repo's, and its flags match live's apart from what is declared
SS_INSTALL=0
if [ $FEATURE = 0 ]; then
  repo_ss=$START_SRC
  host_sha=$(test_ssh "sha256sum $BASE/start-test.sh 2>/dev/null | cut -c1-16" || true)
  repo_sha=$(sha256sum "$repo_ss" | cut -c1-16)
  if [ "$host_sha" = "$repo_sha" ]; then
    echo "  start-test.sh: same as $repo_ss ($repo_sha)"
  elif [ $START_SCRIPT = 1 ]; then
    echo "  start-test.sh: TEST ${host_sha:-none} -> $repo_ss $repo_sha (installed before the restart, old one kept)"; SS_INSTALL=1
  else
    echo "  WARN start-test.sh on TEST (${host_sha:-none}) differs from $repo_ss ($repo_sha): --start-script installs the repo's"
  fi
  pconf=docs/release/$VERSION.conf; pargs=(); [ -f "$pconf" ] && pargs=(--conf "$pconf")
  iargs=(); [ "$INSTANCE" != A ] && iargs=(--instance "$INSTANCE")
  tools/ops/flag-parity "${iargs[@]}" "${pargs[@]}" || echo "  WARN flag parity (above): the deploy goes on; tools/release/stage refuses it"
fi
REMOTE_TAIL=("$MIGRATE" "$BASE" "$UNIT" "$DBN" "$DBC")
echo "remote command: bash -s -- <deploy dir> $HEAD ${REMOTE_TAIL[*]}"
[ $DRY = 1 ] && { echo "dry run: nothing changed"; exit 0; }
if [ $SS_INSTALL = 1 ]; then
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  test_ssh "cp -p $BASE/start-test.sh $BASE/start-test.sh.pre-$stamp 2>/dev/null || true"
  test_scp "$repo_ss" "root@$TEST_HOST:$BASE/start-test.sh"
  test_ssh "chmod 755 $BASE/start-test.sh && bash -n $BASE/start-test.sh" || { echo "start-test.sh install failed" >&2; exit 1; }
fi

if [ $SKIP_BUILD = 0 ]; then
  [ -f config.yaml ] || cp config.example.yaml config.yaml
  echo "building (tests skipped here: run mvn -q -o test before deploying)"
  mvn -q -o -DskipTests package
fi
JAR=target/Cosmic.jar
SHA=$(sha256sum $JAR | cut -c1-16)
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
D=$BASE/deploys/$STAMP
echo "jar $SHA -> $D"

test_ssh "mkdir -p $D/files"
test_scp -q "$JAR" "root@$TEST_HOST:$D/Cosmic.jar"
if [ ${#DATA[@]} -gt 0 ]; then tar czf /tmp/deploy-test-$$.tgz "${DATA[@]}"; test_scp -q "/tmp/deploy-test-$$.tgz" "root@$TEST_HOST:$D/data.tgz"; rm -f /tmp/deploy-test-$$.tgz; fi
for m in "${MIGS[@]}"; do test_scp -q "$m" "root@$TEST_HOST:$D/files/"; done
printf '%s\n' "${GONE[@]}" | test_ssh "cat > $D/deleted.txt"
echo "$HEAD $VERSION $SHA" | test_ssh "cat > $D/DEPLOY.txt"

test_ssh bash -s -- "$D" "$HEAD" "${REMOTE_TAIL[@]}" < "$(dirname "$0")/deploy-test-remote.sh"
# P2-8: the monitor's VERSION_FILE (line 1 version, line 2 commit). Reached only when the remote boot check passed
# (set -e: deploy-test-remote.sh exits 1 on a failed boot, like DEPLOYED_COMMIT it names the last proven version).
printf '%s\n%s\n' "$VERSION" "$HEAD" | test_ssh "cat > $SRV/SLUMSMS_VERSION.tmp && mv -f $SRV/SLUMSMS_VERSION.tmp $SRV/SLUMSMS_VERSION"
echo "done: test server runs $VERSION ($HEAD), backups in $D"
