#!/bin/bash
# Stage a party quest run on the TEST server without logging in to the game.
#
#   tools/ops/mechanics-stage pq ROW for NAME [N] [rangedK]
#
#   pq ROW        any party quest row id: lpq, ellinpq, magatiapq, opq, zakumpq, kpq, ...
#   for NAME      the character who leads; it must be online on TEST when the server picks the request up. QA passes
#                 its pretend player (AqClient), which cannot type a GM 3 command and has no client of its own.
#   N             how many regulars to add (default: the row's minimum party minus the leader's seat)
#   rangedK       how many of those regulars are bowmen/magicians (alternating)
#
# What it does: appends one line "<id> TAB <UTC stamp> TAB <request>" to
# Server/data/mechanics/stage-queue.txt on TEST (mapletest, root@$SLUMS_TEST_HOST, default 192.168.0.111 = mapletest
# since the 1.6.3 cutover; never live on 164) and prints "queued". The server picks it up within 30 s and runs exactly
# what !mechanics pq ROW for NAME would run, with "stage-queue" as the issuer; the [Mechanics] log lines say what
# happened ("PQ staging from the stage queue: <request> -> ...").
#
# Only a QA server answers: the queue needs -Dslums.qa=true and -Dslums.mechanics=true on TEST.
#
# Local mode for the shell test: MECHANICS_LOCAL_DIR=<dir> writes there and never sshes.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"   # TEST_HOST, test_ssh
BASE=/opt/mapleroot-dev/persistence-test

usage() {
    echo "usage: tools/ops/mechanics-stage pq ROW for NAME [N] [rangedK]" >&2
    exit 2
}
[[ $# -ge 1 && "$1" == pq ]] || usage
shift
# The same grammar as MechanicsCommand.parsePq: ROW first, then "for NAME" anywhere, then the counts. "me" is refused
# here: there is nobody typing this, and the command's own for/me refusal must not be reached by a queued line.
ROW="${1:-}"
[[ "$ROW" =~ ^[A-Za-z0-9_-]+$ ]] || usage
shift
NAME=""
N=""
K=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        for)
            [[ -z "$NAME" && $# -ge 2 ]] || usage
            NAME="$2"
            shift 2 ;;
        me) usage ;;
        ranged[0-9])
            [[ "$1" =~ ^ranged([0-9])$ ]] || usage
            K="${BASH_REMATCH[1]}"
            shift ;;
        [0-9]|[0-9][0-9])
            N="$1"
            shift ;;
        *) usage ;;
    esac
done
# v83 names are letters and digits; a count or an option is not a name
[[ "$NAME" =~ ^[A-Za-z0-9]{3,13}$ ]] || { echo "name the leader: pq ROW for NAME (NAME is a character name)" >&2; exit 2; }
if [[ "$NAME" =~ ^(me|for|perfect|hold)$ ]]; then usage; fi
if [[ -n "$N" ]] && { [[ "$N" -lt 1 ]] || [[ "$N" -gt 30 ]]; }; then
    echo "regulars must be 1 to 30 ($N given)" >&2
    exit 2
fi
if [[ -n "$N" && -n "$K" && "$K" -gt "$N" ]]; then
    echo "more ranged regulars ($K) than regulars ($N)" >&2
    exit 2
fi
REQ="pq $ROW for $NAME"
[[ -n "$N" ]] && REQ="$REQ $N"
[[ -n "$K" ]] && REQ="$REQ ranged$K"

# enqueue <dir> <request>: runs where the data dir is (over ssh, or locally with MECHANICS_LOCAL_DIR for the shell test).
enqueue() {
    local dir="$1" req="$2" n k stamp
    mkdir -p "$dir"
    exec 9>"$dir/.stage-queue.lock"
    flock 9
    n=$(( $(cat "$dir/stage-queue.seq" 2>/dev/null || echo 0) + 1 ))
    echo "$n" > "$dir/stage-queue.seq"
    stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    printf '%s\t%s\t%s\n' "$n" "$stamp" "$req" >> "$dir/stage-queue.txt"
    k=$(cat "$dir/stage-queue.txt" "$dir/stage-queue.work" 2>/dev/null | grep -c . || true)
    echo "queued (#$n, position $k) '$req'"
}
if [[ -n "${MECHANICS_LOCAL_DIR:-}" ]]; then
    enqueue "$MECHANICS_LOCAL_DIR" "$REQ"
else
    test_ssh "$(declare -f enqueue); enqueue '$BASE/Server/data/mechanics' '$REQ'"
fi
echo "the test server stages it within 30 s (needs -Dslums.qa=true and -Dslums.mechanics=true)"
