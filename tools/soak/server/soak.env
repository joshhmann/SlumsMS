# slums-soak: the dedicated soak server on LXC 125 (ticket 48). Sourced by start/stop/refresh-soak.sh and soak.sh.
D=/opt/mapleroot-dev/soak-server            # scripts, Server copy, data
SRV=$D/Server
DATA=$D/data                                # gc/, dashboard/, guard/, collect/, runs/, llm-mock.tsv, receipts/
UNIT=slums-soak
MOCK_UNIT=soak-llm-mock
MOCK_PORT=8795                              # local LLM/Decide stand-in, 127.0.0.1 only (never the GPU box, never :8080)
LOGIN_PORT=8509
CHANNEL_BASE=8685                           # 8 channels: 8685-8692
WORLD=1                                     # live's world "Bera"
HEAP=${HEAP:-4G}
SCHEMA=mapleroot_soak
DBUSER=slums_soak
TESTDB_CNF=/opt/mapleroot-dev/solomapling-test/secrets/root.cnf
TESTDB=(--defaults-extra-file=$TESTDB_CNF -h127.0.0.1 -P3307)
LIVE_SRV="/opt/mapleroot/MapleRoot Full Repack/Server"
LIVE_DB=buns-clean-db-1
LIVE_UNIT_FILE=/etc/systemd/system/slumsms.service
