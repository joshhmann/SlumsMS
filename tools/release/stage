#!/bin/bash
# SlumsMS release step 2 (workstation): put one release on the host, ready to rehearse and deploy.
#
#   tools/release/stage <version> [--conf FILE] [--replace] [--allow-version-mismatch] [--allow-skipped-tests] [--dry-run]
#
# Needs tools/release/build first (dist/release-build, same commit as this checkout) and docs/release/<version>.conf
# (template: tools/release/templates/release.conf.example). Builds dist/release-stage/<version>/ and copies it to
# $RELEASE_HOST:/opt/mapleroot-deployments/v<version>/:
#   staging/   Cosmic.jar, scripts.tar (+.list), srcdata.tar (+.list: every non-.java file git tracks under src/main),
#              migrations/ (every repo migration and rollback), config files, BUILD.txt, COMMIT, release.conf, SHA256SUMS
#   deploy.sh, rollback.sh (generated, see gen-deploy), DEPLOY-NOTES.md, CHECKLIST.md, tools/ (this folder)
# A version folder that already has a deploy.log or a backup is never touched (versions are immutable once deployed).
# --replace re-stages a version that was staged but never deployed.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd); . "$here/lib.sh"
REPO=$(cd "$here/../.." && pwd)
VERSION=${1:-}; shift || true
valid_version "$VERSION" || die "usage: stage <version> [options]   (version like 1.3.2)"
CONF=$REPO/docs/release/$VERSION.conf REPLACE=0 VMISMATCH=0 SKIPPED_OK=0 DRY_RUN=0
while [ $# -gt 0 ]; do case $1 in
  --conf) CONF=$(realpath "$2"); shift;; --replace) REPLACE=1;; --allow-version-mismatch) VMISMATCH=1;;
  --allow-skipped-tests) SKIPPED_OK=1;; --dry-run) DRY_RUN=1;; *) die "unknown option $1";; esac; shift; done
require_workstation
BUILD=$REPO/dist/release-build
OUT=$REPO/dist/release-stage/$VERSION
D=$DEPLOY_ROOT/v$VERSION
cd "$REPO"

step "checks"
[ -f "$CONF" ] || die "no release conf $CONF (copy tools/release/templates/release.conf.example)"
[ -f "$BUILD/BUILD.txt" ] || die "no build; run tools/release/build"
bcommit=$(sed -n 's/^commit=//p' "$BUILD/BUILD.txt"); jver=$(sed -n 's/^version=//p' "$BUILD/BUILD.txt")
tests=$(sed -n 's/^tests=//p' "$BUILD/BUILD.txt")
# the checkout may be ahead of the build only in tools/release and docs (the jar, scripts and data must match)
git diff --quiet "$bcommit" HEAD -- . ':!tools/release' ':!docs' \
  || die "build is of $bcommit, the checkout ($(git rev-parse --short=9 HEAD)) changed more than tools/docs since; rebuild"
[ -z "$(git status --porcelain --untracked-files=no -- scripts src/main database)" ] || die "uncommitted changes under scripts/, src/main/ or database/"
[ "$(sha256sum "$BUILD/Cosmic.jar" | cut -d' ' -f1)" = "$(sed -n 's/^jar_sha256=//p' "$BUILD/BUILD.txt")" ] || die "build jar hash does not match BUILD.txt"
[ "$jver" = "$VERSION" ] || [ "$VMISMATCH" = 1 ] || die "jar says SLUMSMS_VERSION $jver, staging as $VERSION (bump ServerConstants, or --allow-version-mismatch for a dry run)"
case $tests in SKIPPED*) [ "$SKIPPED_OK" = 1 ] || die "build skipped the suite";; esac
echo "version $VERSION, jar version $jver, commit $bcommit, tests: $tests"
remote_state=$(ssh -o BatchMode=yes "$RELEASE_HOST" "if [ -e '$D/deploy.log' ] || [ -e '$D/backup' ]; then echo deployed; elif [ -e '$D' ]; then echo staged; else echo none; fi")
echo "host $RELEASE_HOST:$D is: $remote_state"
[ "$remote_state" != deployed ] || die "$D was already deployed (deploy.log or backup present); stage a new version"
[ "$remote_state" != staged ] || [ "$REPLACE" = 1 ] || [ "$DRY_RUN" = 1 ] || die "$D is already staged; --replace to re-stage it"

step "build $OUT"
rm -rf "$OUT"; mkdir -p "$OUT/staging/migrations" "$OUT/tools"
ST=$OUT/staging
cp "$BUILD/Cosmic.jar" "$BUILD/BUILD.txt" "$ST/"; echo "$bcommit" > "$ST/COMMIT"; cp "$CONF" "$ST/release.conf"
git ls-files scripts > "$ST/scripts.list"
git ls-files src/main | grep -v '\.java$' > "$ST/srcdata.list"
tar --owner=0 --group=0 -cf "$ST/scripts.tar" -T "$ST/scripts.list"
tar --owner=0 --group=0 -cf "$ST/srcdata.tar" -T "$ST/srcdata.list"
cp database/migrations/*.sql "$ST/migrations/"
( . "$CONF"; for f in "${CONFIG_HEAD:-}" "${CONFIG_APPEND:-}"; do [ -z "$f" ] || cp "$REPO/$f" "$ST/"; done )
(cd "$ST" && find . -type f ! -name SHA256SUMS -printf '%P\n' | LC_ALL=C sort | xargs -d '\n' sha256sum > SHA256SUMS)
"$here/gen-deploy" "$CONF" "$BUILD" "$OUT" "$VERSION"
cp -r "$here"/. "$OUT/tools/"
cp "$here/templates/CHECKLIST.md" "$OUT/CHECKLIST.md"
sed -i "s/<version>/$VERSION/g" "$OUT/CHECKLIST.md"
{
  echo "# SlumsMS $VERSION deploy notes (generated by tools/release/stage)"
  echo
  echo "Staged $(date -u '+%Y-%m-%d %H:%M UTC') from commit $bcommit; jar $(sha256sum "$ST/Cosmic.jar" | cut -c1-16), SLUMSMS_VERSION $jver; suite: $tests."
  echo
  echo "1. Rehearse on a copy of live (from the workstation): \`tools/release/rehearse $VERSION\` -> \`REHEARSAL.md\` here."
  echo "2. Check against live, changes nothing: \`bash $D/deploy.sh --dry-run\`"
  echo "3. Deploy (owner): \`bash $D/deploy.sh\` -> \`RECEIPT.md\` here, backup in \`backup/\`."
  echo "4. Rollback if needed: \`bash $D/rollback.sh\` (keeps player progress; \`--dry-run\` first)."
  echo
  echo "Settings (from \`staging/release.conf\`):"
  echo
  sed -n '/^D=/,/^# ---- body/p' "$OUT/deploy.sh" | grep -v '^# ---- body' | sed 's/^/    /'
} > "$OUT/DEPLOY-NOTES.md"
du -sh --apparent-size "$ST"

if [ "$DRY_RUN" = 1 ]; then step "dry run: built $OUT, not copied to $RELEASE_HOST:$D"; exit 0; fi
step "copy to $RELEASE_HOST:$D"
ssh "$RELEASE_HOST" "mkdir -p '$D'"
rsync -a --delete --exclude backup --exclude '*.log' --exclude 'RECEIPT.md' --exclude 'REHEARSAL.md' "$OUT/" "$RELEASE_HOST:$D/"
ssh "$RELEASE_HOST" "cd '$D/staging' && sha256sum -c --quiet SHA256SUMS && echo 'host staging verified'"
step "staged. Next: tools/release/rehearse $VERSION"
