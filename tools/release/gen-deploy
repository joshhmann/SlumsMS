#!/bin/bash
# Generate deploy.sh and rollback.sh for one release (called by stage; can be run alone to inspect the output).
#
#   tools/release/gen-deploy <release.conf> <build dir with BUILD.txt> <out dir> <version>
#
# Writes <out>/deploy.sh and <out>/rollback.sh: a settings header baked from release.conf + the repo's migrations,
# followed by the fixed bodies in templates/. The scripts expect their staging folder at
# /opt/mapleroot-deployments/v<version>/staging (see stage).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd); . "$here/lib.sh"
REPO=$(cd "$here/../.." && pwd)
[ $# = 4 ] || die "usage: gen-deploy <release.conf> <build dir> <out dir> <version>"
CONF=$1 BUILD=$2 OUT=$3 VERSION=$4
valid_version "$VERSION" || die "bad version $VERSION"
[ -f "$CONF" ] && [ -f "$BUILD/BUILD.txt" ] || die "need $CONF and $BUILD/BUILD.txt"

# defaults, then the release's settings
MIGRATIONS=() LEDGER_NOT_LIVE=() LEDGER_BEFORE=__auto__ CONFIG_APPEND="" CONFIG_HEAD="" CONFIG_HEAD_BEFORE=""
MIN_CLIENT_BUILD="" CHANNELS="" CHANNEL_LOAD="" SERVER_SET=()
UNIT_EDITS=() PRECHECK_SQL=() NAV_CACHE_SRC="" CASHSHOP_CATALOG="" EXPECT_LOG=() FORBID_LOG=() SMOKE_SECONDS=30
IN_GAME_CHECK="In game: log in, enter a character, change channel."
MAINT_MINUTES=5 MAINT_REASON=""
. "$CONF"
COMMIT=$(sed -n 's/^commit=//p' "$BUILD/BUILD.txt"); JAR_VERSION=$(sed -n 's/^version=//p' "$BUILD/BUILD.txt")
JAR_SHA16=$(sed -n 's/^jar_sha256=//p' "$BUILD/BUILD.txt" | cut -c1-16)

M=$REPO/database/migrations
MIGRATION_FILES=() MIGRATION_IDS=()
for f in "${MIGRATIONS[@]}"; do
  [ -f "$M/$f.sql" ] || die "no migration $M/$f.sql"; [ -f "$M/$f.rollback.sql" ] || die "no $M/$f.rollback.sql"
  id=$(ledger_id "$M/$f.sql"); [ -n "$id" ] || die "$f.sql does not write the ledger ($LEDGER_TABLE.$LEDGER_COL)"
  grep -q "$LEDGER_COL *= *'$id'" "$M/$f.rollback.sql" || die "$f.rollback.sql does not remove '$id' from the ledger"
  MIGRATION_FILES+=("$f"); MIGRATION_IDS+=("$id")
done
if [ "$LEDGER_BEFORE" = __auto__ ]; then
  ids=()
  for f in "$M"/*.sql; do
    case $f in *.rollback.sql) continue;; esac
    id=$(ledger_id "$f"); [ -n "$id" ] || continue
    skip=0; for x in "${MIGRATION_IDS[@]}" "${LEDGER_NOT_LIVE[@]}"; do [ "$x" = "$id" ] && skip=1; done
    [ $skip = 1 ] || ids+=("$id")
  done
  LEDGER_BEFORE=$(printf '%s\n' "${ids[@]}" | LC_ALL=C sort | paste -sd,)
fi
EXPECT_LOG=("SlumsMS v$JAR_VERSION" "is now online" "${EXPECT_LOG[@]}")
[ -z "$CONFIG_HEAD" ] || [ -n "$CONFIG_HEAD_BEFORE" ] || die "CONFIG_HEAD needs CONFIG_HEAD_BEFORE"
for f in "$CONFIG_HEAD" "$CONFIG_APPEND" "$CASHSHOP_CATALOG"; do [ -z "$f" ] || [ -f "$REPO/$f" ] || die "no $REPO/$f"; done
# SERVER_SET: numeric server: keys edited in place (or added) by set-release-config --set. The config loader is
# strict (an unknown key aborts the boot), so every key must be a numeric field of this build's ServerConfig.java.
SC=$REPO/src/main/java/config/ServerConfig.java
declare -A set_seen=()
for kv in "${SERVER_SET[@]}"; do
  [[ $kv =~ ^([A-Z][A-Z0-9_]*)=([0-9]{1,9}(\.[0-9]{1,6})?)$ ]] || die "SERVER_SET entry '$kv' is not KEY=NUMBER"
  k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
  [ -z "${set_seen[$k]:-}" ] || die "SERVER_SET sets $k twice"; set_seen[$k]=1
  case $k in CHANNEL_LOAD|MIN_CLIENT_BUILD|CHANNELS) die "SERVER_SET $k: use CHANNEL_LOAD/MIN_CLIENT_BUILD/CHANNELS";; esac
  t=$(sed -nE "s/^[[:space:]]*public[[:space:]]+(int|long|double|float)[[:space:]]+$k[[:space:]]*(=|;).*/\1/p" "$SC" | head -1)
  [ -n "$t" ] || die "SERVER_SET $k is not a numeric field of ServerConfig.java (the strict config would refuse it)"
  case $t in int|long) [[ $v != *.* ]] || die "SERVER_SET $k is an $t; $v is not a whole number";; esac
  if [ -n "$CONFIG_APPEND" ] && grep -qE "^[[:space:]]+$k:" "$REPO/$CONFIG_APPEND"; then die "SERVER_SET $k is also in $CONFIG_APPEND"; fi
done

mkdir -p "$OUT"
sq() { local s=${1//\'/\'\\\'\'}; printf "'%s'" "$s"; }   # single-quote for the generated file
header() {
  cat <<H
#!/bin/bash
# SlumsMS $VERSION live $1. GENERATED by tools/release/gen-deploy from $(basename "$CONF") (commit $COMMIT) on
# $(date -u '+%Y-%m-%d %H:%M UTC'). Do not edit by hand: change the release conf and run tools/release/stage again.
#
#   bash $DEPLOY_ROOT/v$VERSION/$1.sh --dry-run   # checks only, against live; changes nothing
#   bash $DEPLOY_ROOT/v$VERSION/$1.sh
H
  echo "D=$DEPLOY_ROOT/v$VERSION"
  for v in VERSION COMMIT JAR_VERSION JAR_SHA16 LEDGER_BEFORE NAV_CACHE_SRC SMOKE_SECONDS IN_GAME_CHECK CONFIG_HEAD_BEFORE \
           MAINT_MINUTES MAINT_REASON MIN_CLIENT_BUILD CHANNELS CHANNEL_LOAD; do
    printf '%s=%s\n' "$v" "$(sq "${!v}")"
  done
  # staged copies of the config files live in staging/ under their base names
  printf 'CASHSHOP_CATALOG=%s\n' "$(sq "${CASHSHOP_CATALOG:+$(basename "$CASHSHOP_CATALOG")}")"
  printf 'CONFIG_HEAD=%s\nCONFIG_APPEND=%s\n' "$(sq "${CONFIG_HEAD:+$(basename "$CONFIG_HEAD")}")" "$(sq "${CONFIG_APPEND:+$(basename "$CONFIG_APPEND")}")"
  for a in MIGRATION_FILES MIGRATION_IDS UNIT_EDITS SERVER_SET PRECHECK_SQL EXPECT_LOG FORBID_LOG; do
    declare -n arr=$a; printf '%s=(' "$a"; sep=""; for x in "${arr[@]}"; do printf '%s%s' "$sep" "$(sq "$x")"; sep=" "; done; echo ')'; unset -n arr
  done
}
{ header deploy; cat "$here/templates/deploy.body.sh"; } > "$OUT/deploy.sh"
{ header rollback; cat "$here/templates/rollback.body.sh"; } > "$OUT/rollback.sh"
chmod +x "$OUT/deploy.sh" "$OUT/rollback.sh"
bash -n "$OUT/deploy.sh" && bash -n "$OUT/rollback.sh"
echo "generated $OUT/deploy.sh, $OUT/rollback.sh (migrations: ${MIGRATION_IDS[*]:-none}; ledger before: $LEDGER_BEFORE)"
