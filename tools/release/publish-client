#!/bin/bash
# SlumsMS release step 5a (workstation): publish a client layer (and optionally a release manifest) on the patch
# server, with the hash-diff rule built in.
#
#   tools/release/publish-client <client-version> --source <host dir> [--base <base version>]
#       [--release <release version> [--news FILE.json (host path)] [--no-packs]] [--sync-publisher] [--no-announce] [--dry-run]
#
# 1. Hash-diff (verify-client.py on the host): published base layer + the client staging tree vs the reference
#    client ($REFERENCE), and vs the release players have now (manifest.json): zero unexpected missing/different/
#    extra files and nothing the current release has dropped, or nothing is published. Allowed differences are in
#    tools/release/client-allow.txt (the SlumsMS overlay, listed path by path).
# 2. node tools/publish.mjs --layer client (the host's copy of the launcher repo's publisher, checked against
#    $LAUNCHER_REPO first). 3. The same hash-diff on the published client layer manifest.
# 4. With --release: back up manifest.json, then node tools/publish.mjs --release ... --use base@B --use client@V
#    (manifest.json is written last, by the publisher).
# --no-packs: the release manifest references no first-install packs (publish.mjs --release --no-packs), for a client
# release that goes out before the launcher/packs release.
# --dry-run: steps 1 and the publisher check only; prints the publish commands.
# The checks (also on --dry-run) validate --news with the publisher's own limits (publish_checks.py news), so a bad news
# file stops the run before anything is published. Rerun after a failed run: a client layer <client-version> that is
# already published is reused when its manifest.json is byte for byte the one this staging tree would publish (same
# SHA-256, publish_checks.py same-layer); a different one still aborts (layers are immutable).
# On the LIVE feed (PATCH_DIR = $LIVE_PATCH_DIR, default /srv/slums-patch) step 1 and 3 also refuse a client whose
# config.ini [config] host/port differs from the live client layer's (ALLOW_LIVE_ENDPOINT_CHANGE=1 for a real move).
# After a --release manifest, Cody posts that the client is in the launcher (slumsms-monitor client-ready on the host,
# target $ANNOUNCE_TARGET, default live); --no-announce skips it. The server deploy posts its own going down / back up.
# (tools/release/release passes --no-announce: its maintenance end post carries the client line.)
#
#   tools/release/publish-client --restore-manifest <host file> [--dry-run]
#
# Puts a saved release manifest back (e.g. $STAGING_DIR/manifest-before-<release>.json, which every --release run
# saves first) as manifest.json and mirrors it to /launcher-test/, so players get the previous client again on Play.
# Every layer it names must still be published (layers are never deleted). The manifest it replaces is kept as
# $STAGING_DIR/manifest-replaced-<UTC>.json. No Cody post. Published layers stay (immutable, unreferenced).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd); . "$here/lib.sh"; . "$here/publish-lib.sh"
# Rehearsal only: PUBLISH_TEST_FAIL=after-layer|after-manifest makes the run fail at that point (refused on the live feed).
PUBLISH_TEST_FAIL=${PUBLISH_TEST_FAIL:-}
if [ -n "$PUBLISH_TEST_FAIL" ] && [ "$PATCH_DIR" = /srv/slums-patch ]; then die "PUBLISH_TEST_FAIL is for rehearsal feeds only"; fi
test_fail() { if [ "$PUBLISH_TEST_FAIL" = "$1" ]; then die "PUBLISH_TEST_FAIL=$1: simulated publish failure (rehearsal)"; fi; }

if [ "${1:-}" = --restore-manifest ]; then
  FILE=${2:-}; DRY_RUN=0; [ "${3:-}" = --dry-run ] && DRY_RUN=1
  [ -n "$FILE" ] || die "usage: publish-client --restore-manifest <host file> [--dry-run]"
  require_workstation
  step "restore $FILE as $PATCH_DIR/manifest.json (+ /launcher-test/ mirror)"
  h "python3 -I - $(q "$FILE") $(q "$PATCH_DIR")" <<'PY' || die "$FILE is not a release manifest whose layers are all published; nothing changed"
import json, os, sys
f, out = sys.argv[1], sys.argv[2]
m = json.load(open(f))
assert m.get("schemaVersion") and m.get("version") and m.get("layers"), "not a release manifest"
for l in m["layers"]:
    lm = os.path.join(out, "layers", l["name"], l["version"], "manifest.json")
    assert os.path.isfile(lm), "layer %s@%s is not published (%s)" % (l["name"], l["version"], lm)
cur = json.load(open(os.path.join(out, "manifest.json")))
print("now:      ", cur["version"], [(l["name"], l["version"]) for l in cur["layers"]])
print("restoring:", m["version"], [(l["name"], l["version"]) for l in m["layers"]])
PY
  if [ "$DRY_RUN" = 1 ]; then step "DRY RUN OK: nothing changed"; exit 0; fi
  h "set -e; cp $(q "$PATCH_DIR/manifest.json") $(q "$STAGING_DIR")/manifest-replaced-\$(date -u +%Y%m%dT%H%M%SZ).json
     cp $(q "$FILE") $(q "$PATCH_DIR/manifest.json.restore") && mv $(q "$PATCH_DIR/manifest.json.restore") $(q "$PATCH_DIR/manifest.json")
     if [ -L $(q "$PATCH_DIR/launcher-test/layers") ]; then cp $(q "$FILE") $(q "$PATCH_DIR/launcher-test/manifest.json.new") && mv $(q "$PATCH_DIR/launcher-test/manifest.json.new") $(q "$PATCH_DIR/launcher-test/manifest.json"); echo 'launcher-test mirrored'; fi
     cmp $(q "$FILE") $(q "$PATCH_DIR/manifest.json") && echo 'manifest.json restored'" || die "restore of $FILE did not complete; check $PATCH_DIR/manifest.json by hand"
  step "done"
  exit 0
fi
CV=${1:-}; shift || true
[[ "$CV" =~ ^[A-Za-z0-9._-]+$ ]] || die "usage: publish-client <client-version> --source DIR [...]"
SRC="" BASE="" REL="" NEWS="" SYNC=0 DRY_RUN=0 ANNOUNCE=1 NOPACKS=0
ANNOUNCE_TARGET=${ANNOUNCE_TARGET:-live}
while [ $# -gt 0 ]; do case $1 in
  --source) SRC=$2; shift;; --base) BASE=$2; shift;; --release) REL=$2; shift;; --news) NEWS=$2; shift;;
  --sync-publisher) SYNC=1;; --no-packs) NOPACKS=1;; --dry-run) DRY_RUN=1;; --no-announce) ANNOUNCE=0;; *) die "unknown option $1";; esac; shift; done
[ -n "$SRC" ] || die "--source <client staging dir on the host> is required"
[ "$NOPACKS" = 0 ] || [ -n "$REL" ] || die "--no-packs needs --release"
[ -z "$NEWS" ] || [ -n "$REL" ] || die "--news needs --release (news goes into the release manifest)"
require_workstation

step "checks"
h "test -d $(q "$SRC")" || die "no $SRC on $RELEASE_HOST"
checks() { h "nice -n 19 ionice -c3 python3 -I - $(q "$@")" < "$here/publish_checks.py"; }
if [ -n "$NEWS" ]; then
  h "test -f $(q "$NEWS")" || die "no news file $NEWS on $RELEASE_HOST"
  checks news "$NEWS" || die "news file $NEWS would be refused by the publisher: nothing published. Fix it and rerun"
fi
# A layer an earlier (failed) run published from this same staging tree is reused; any other is immutable.
LAYER_DONE=0
if h "test -e $(q "$PATCH_DIR/layers/client/$CV")"; then
  echo "client layer $CV is already published; comparing it with what $SRC would publish (hashes the whole tree)"
  if checks same-layer "$SRC" "$PATCH_DIR/layers/client/$CV" client "$CV"; then
    LAYER_DONE=1; echo "client layer $CV is identical to $SRC (same manifest SHA-256): reusing it, not publishing it again"
  else
    die "client layer $CV is already published with different files or is incomplete (layers are immutable; pick a new version)"
  fi
fi
if [ -z "$BASE" ]; then
  BASE=$(h "python3 -I -c 'import json,sys; m=json.load(open(sys.argv[1])); print([l[\"version\"] for l in m[\"layers\"] if l[\"name\"]==\"base\"][0])' $PATCH_DIR/manifest.json")
fi
echo "base layer: $BASE (from the current manifest.json unless --base)"
h "test -f $(q "$PATCH_DIR/layers/base/$BASE/manifest.json")" || die "base layer $BASE is not published"
h "test ! -e $(q "$SRC/launcher.config.json")" || die "$SRC contains launcher.config.json"
check_publisher "$SYNC"
scp -q "$here/client-allow.txt" "$RELEASE_HOST:/tmp/slums-client-allow.txt"
# The LIVE feed: a client layer published there must point at the live server (config.ini [config] host and port, as
# in the client layer live players have now). A test-server client on the live feed would send every player to the
# test server. RC feeds (e.g. PATCH_DIR=/srv/slums-patch/launcher-rc) are not checked. A deliberate move of the live
# server: ALLOW_LIVE_ENDPOINT_CHANGE=1.
LIVE_PATCH_DIR=${LIVE_PATCH_DIR:-/srv/slums-patch}
live_args=""
if [ "${PATCH_DIR%/}" = "${LIVE_PATCH_DIR%/}" ]; then
  live_args=" --live-feed $(q "$PATCH_DIR")"
  [ "${ALLOW_LIVE_ENDPOINT_CHANGE:-0}" = 1 ] && live_args+=" --allow-endpoint-change"
  echo "live feed: the client's config.ini must match the live server's host and port"
fi
verify() {  # $1: --client-dir DIR | --client-manifest FILE
  h "nice -n 19 ionice -c3 python3 -I - --base-manifest $(q "$PATCH_DIR/layers/base/$BASE/manifest.json") $1 $(q "$2") --reference $(q "$REFERENCE") --allow /tmp/slums-client-allow.txt --cache $(q "$REF_CACHE") --previous $(q "$PATCH_DIR/manifest.json")$live_args" < "$here/verify-client.py"
}

step "hash-diff: base $BASE + $SRC vs the reference client"
verify --client-dir "$SRC" || die "hash-diff or live endpoint check failed: nothing published. Fix the staging tree (derive the overlay from a hash diff, never from addon folder lists; on the live feed config.ini must point at the live server)"

pub_layer="$NODE tools/publish.mjs --layer client --source $(q "$SRC") --out $(q "$PATCH_DIR") --version $(q "$CV")"
pub_rel="$NODE tools/publish.mjs --release $(q "$REL") --out $(q "$PATCH_DIR") --use base@$(q "$BASE") --use client@$(q "$CV")${NEWS:+ --news $(q "$NEWS")}$([ "$NOPACKS" = 1 ] && echo " --no-packs" || true)"
if [ "$DRY_RUN" = 1 ]; then
  step "DRY RUN OK. Would run on $RELEASE_HOST (cd $PUBLISHER):"
  if [ "$LAYER_DONE" = 1 ]; then echo "  (client layer $CV already published, identical: skipped)"; else echo "  $pub_layer"; fi
  [ -n "$REL" ] && echo "  cp $PATCH_DIR/manifest.json $STAGING_DIR/manifest-before-$REL.json && $pub_rel"
  exit 0
fi

if [ "$LAYER_DONE" = 1 ]; then
  step "client layer $CV: already published from these files, skipped"
else
  step "publish client layer $CV"
  h "cd $PUBLISHER && $pub_layer"
fi
step "hash-diff again on the published layer manifest"
verify --client-manifest "$PATCH_DIR/layers/client/$CV/manifest.json" || die "published layer $CV fails the hash-diff; manifest.json NOT updated. Do not point a release at it"
test_fail after-layer
if [ -n "$REL" ]; then
  step "release manifest $REL (manifest.json last; the old one saved as $STAGING_DIR/manifest-before-$REL.json)"
  # Never overwrite a saved manifest with a different one: it is the way back (--restore-manifest).
  h "b=$(q "$STAGING_DIR/manifest-before-$REL.json"); if [ -e \"\$b\" ] && ! cmp -s \"\$b\" $(q "$PATCH_DIR/manifest.json"); then echo \"\$b exists and differs from manifest.json\" >&2; exit 1; fi; cp $(q "$PATCH_DIR/manifest.json") \"\$b\"" \
    || die "refusing to overwrite $STAGING_DIR/manifest-before-$REL.json; manifest.json NOT updated"
  h "cd $PUBLISHER && $pub_rel"
  h "python3 -I -c 'import json; m=json.load(open(\"$PATCH_DIR/manifest.json\")); print(\"manifest.json:\", m[\"version\"], [(l[\"name\"], l[\"version\"]) for l in m[\"layers\"]])'"
  # The owner's everyday launcher reads /launcher-test/ (game feed + launcher self-update) and must match live.
  # Its layers/ is a symlink to ../layers, so the live manifest works there as is. RCs get their own channel.
  h "test -L $(q "$PATCH_DIR/launcher-test/layers") && cp $(q "$PATCH_DIR/manifest.json") $(q "$PATCH_DIR/launcher-test/manifest.json.new") && mv $(q "$PATCH_DIR/launcher-test/manifest.json.new") $(q "$PATCH_DIR/launcher-test/manifest.json") && echo 'launcher-test feed now mirrors live'" \
    || echo "WARN: /launcher-test/ not mirrored (no layers symlink there?); the owner's launcher stays on its old release"
  test_fail after-manifest
  if [ "$ANNOUNCE" = 1 ]; then
    step "Cody: client $REL is in the launcher (public channel; --no-announce skips)"
    h "command -v slumsms-monitor >/dev/null && slumsms-monitor client-ready $(q "$ANNOUNCE_TARGET") $(q "$REL")" \
      || echo "WARN: no Cody post (slumsms-monitor missing or the post failed); the release itself is published"
  fi
fi
step "done"
