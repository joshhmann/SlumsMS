# Starts at boot (owner 2026-10-29, an exception to /root/MODEL_DOCTRINE.md's no-autostart rule): bots read chat by
# rules alone while it is down. Pinned to one GPU by UUID and capped in memory, so it cannot take the other cards.
# Install with enable-at-boot.sh; the repo copy is tools/chatbank/units/decide-8913.service.
[Unit]
Description=OneJev1.6-0.8B-chat-r7 Decide, trained (intent and con) (:8913)
After=network-online.target
Wants=network-online.target
# wait up to 5 min for the GPU at boot instead of crash-looping before the driver is up
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/OneJev
# pinned by GPU UUID: CUDA index order differs from nvidia-smi; cuda:0 is then the only visible card
Environment=CUDA_VISIBLE_DEVICES=GPU-e22a7e7d-d13e-b2ce-8cbc-da280a63f95a
ExecStartPre=/bin/sh -c 'for i in $$(seq 150); do nvidia-smi -L | grep -q GPU-e22a7e7d-d13e-b2ce-8cbc-da280a63f95a && exit 0; sleep 2; done; exit 1'
ExecStart=/root/venvs/decide/bin/flide serve --model /root/models/jev-small/OneJev1.6-0.8B-chat-r7 --device cuda:0 --host 0.0.0.0 --port 8913 \
    --dtype bfloat16 --session-cache-gb 0.1 --no-cuda-graphs --max-request-tokens 1024
Restart=on-failure
RestartSec=5
OOMScoreAdjust=-400
MemoryMax=6G
StandardOutput=journal
StandardError=journal
SyslogIdentifier=decide-8913

[Install]
WantedBy=multi-user.target
